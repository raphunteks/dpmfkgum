<%- include('partials/header') %>

<div class="space-y-16 animate-fade-in">
    
    <!-- HERO SECTION (Holographic & Float) -->
    <section class="relative text-center flex flex-col items-center justify-center min-h-[65vh] animate-float">
        <div class="px-4 py-1.5 text-xs font-bold rounded-full uppercase tracking-widest mb-6 neu-inset text-[var(--brand-primary)]">
            <i class="ph ph-shield-check inline-block mr-1"></i> Portal Resmi Legislatif v2.0
        </div>
        
        <h1 class="text-6xl md:text-8xl font-black tracking-tighter holographic-text pb-4 drop-shadow-2xl">
            <%= DB.organization.name %>
        </h1>
        
        <p class="mt-4 text-xl md:text-2xl text-[var(--text-muted)] max-w-3xl mx-auto font-medium leading-relaxed">
            <%= DB.organization.tagline %>
        </p>
        
        <div class="mt-12 flex flex-col sm:flex-row gap-6">
            <a href="/tentang" class="px-10 py-4 text-lg rounded-2xl font-bold neu-flat text-[var(--text-main)] flex items-center justify-center gap-3 hover:text-[var(--brand-primary)] group">
                <i class="ph ph-magnifying-glass text-2xl group-hover:scale-110 transition-transform"></i> Kenali Kami
            </a>
            <a href="/berita" class="px-10 py-4 text-lg rounded-2xl font-bold bg-gradient-to-r from-cyan-500 to-blue-500 text-white shadow-[0_10px_30px_rgba(14,165,233,0.4)] hover:shadow-[0_15px_40px_rgba(14,165,233,0.6)] hover:-translate-y-1 transition-all flex items-center justify-center gap-3">
                <i class="ph ph-planet text-2xl animate-pulse"></i> Berita Terkini
            </a>
        </div>
    </section>

    <!-- STATS (Neumorphism Glass Hybrid) -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="glass-card p-8 flex flex-col items-center text-center relative overflow-hidden">
            <div class="absolute -right-4 -top-4 w-24 h-24 bg-cyan-400/20 rounded-full blur-2xl"></div>
            <div class="w-16 h-16 rounded-2xl neu-inset flex items-center justify-center mb-6">
                <i class="ph ph-hourglass-high text-3xl text-cyan-500"></i>
            </div>
            <h3 class="text-4xl font-black text-[var(--text-main)] mb-2">Periode</h3>
            <p class="text-[var(--text-muted)] font-semibold uppercase tracking-wide"><%= DB.periods.find(p => p.status === 'ACTIVE').name %></p>
        </div>
        
        <div class="glass-card p-8 flex flex-col items-center text-center relative overflow-hidden">
            <div class="absolute -left-4 -bottom-4 w-24 h-24 bg-blue-500/20 rounded-full blur-2xl"></div>
            <div class="w-16 h-16 rounded-2xl neu-inset flex items-center justify-center mb-6">
                <i class="ph ph-briefcase-metal text-3xl text-blue-500"></i>
            </div>
            <h3 class="text-4xl font-black text-[var(--text-main)] mb-2"><%= DB.programs.length %></h3>
            <p class="text-[var(--text-muted)] font-semibold uppercase tracking-wide">Program Kerja</p>
        </div>
        
        <div class="glass-card p-8 flex flex-col items-center text-center relative overflow-hidden">
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-32 h-32 bg-indigo-500/10 rounded-full blur-3xl"></div>
            <div class="w-16 h-16 rounded-2xl neu-inset flex items-center justify-center mb-6">
                <i class="ph ph-calendar-star text-3xl text-indigo-500"></i>
            </div>
            <h3 class="text-4xl font-black text-[var(--text-main)] mb-2"><%= DB.events.length %></h3>
            <p class="text-[var(--text-muted)] font-semibold uppercase tracking-wide">Agenda Event</p>
        </div>
    </section>

    <!-- NEWS PREVIEW -->
    <section>
        <div class="flex justify-between items-end mb-8 border-b border-[var(--glass-border)] pb-4">
            <div>
                <h2 class="text-3xl font-black text-[var(--text-main)] holographic-text inline-block">Flash Update</h2>
                <p class="text-[var(--text-muted)] mt-1 font-medium">Radar informasi legislatif terkini</p>
            </div>
            <a href="/berita" class="hidden sm:flex px-6 py-2.5 rounded-full neu-flat text-sm font-bold text-[var(--text-main)] hover:text-cyan-500 items-center gap-2 transition-all">Lihat Semua <i class="ph ph-arrow-right-bold"></i></a>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <% DB.news.slice(0, 2).forEach(item => { %>
                <a href="/berita/<%= item.slug %>" class="neu-flat overflow-hidden group flex flex-col" aria-label="Baca: <%= item.title %>">
                    <div class="h-64 overflow-hidden relative p-4">
                        <div class="w-full h-full rounded-2xl overflow-hidden relative">
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/90 via-transparent to-transparent z-10"></div>
                            <img src="<%= item.image %>" alt="<%= item.title %>" class="w-full h-full object-cover group-hover:scale-110 group-hover:rotate-1 transition-all duration-700 ease-out" />
                            <div class="absolute bottom-4 left-4 z-20">
                                <span class="px-3 py-1.5 text-xs font-black uppercase tracking-wider rounded-lg glass-card text-cyan-300 shadow-xl">Hot News</span>
                            </div>
                        </div>
                    </div>
                    <div class="p-8 pt-2">
                        <div class="flex items-center gap-2 text-xs font-bold text-[var(--brand-primary)] mb-3 uppercase tracking-wider">
                            <i class="ph ph-calendar-blank"></i> <%= item.date %>
                        </div>
                        <h3 class="text-2xl font-black text-[var(--text-main)] mb-3 leading-tight group-hover:text-[var(--brand-primary)] transition-colors"><%= item.title %></h3>
                        <p class="text-[var(--text-muted)] leading-relaxed line-clamp-2 font-medium"><%= item.excerpt %></p>
                    </div>
                </a>
            <% }) %>
        </div>
    </section>
</div>

<%- include('partials/footer') %>
