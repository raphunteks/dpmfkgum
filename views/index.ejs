<%- include('partials/header') %>

<div class="space-y-12 animate-fade-in relative z-10">
    <section class="relative pt-20 pb-10 text-center flex flex-col items-center justify-center min-h-[60vh]">
        <span class="px-3 py-1 text-xs font-semibold rounded-full border bg-dentistry-100 text-dentistry-600 border-dentistry-200 dark:bg-green-500/20 dark:text-green-300 dark:border-green-500/30 shadow-sm transition-colors">Portal Resmi v2.0</span>
        <h1 class="mt-6 text-5xl md:text-7xl font-extrabold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-slate-900 via-dentistry-600 to-blue-600 dark:from-white dark:via-slate-200 dark:to-slate-400">
            <%= DB.organization.name %>
        </h1>
        <p class="mt-6 text-xl text-slate-600 dark:text-slate-300 max-w-2xl mx-auto font-light leading-relaxed transition-colors">
            <%= DB.organization.tagline %>
        </p>
        <div class="mt-10 flex flex-col sm:flex-row gap-4">
            <a href="/tentang" class="px-8 py-3 text-lg rounded-xl font-medium bg-dentistry-500 hover:bg-dentistry-600 dark:bg-brand-500 dark:hover:bg-brand-600 text-white shadow-lg shadow-dentistry-500/30 dark:shadow-brand-500/30 flex items-center justify-center gap-2 transition-all"><i class="ph ph-magnifying-glass"></i> Kenali Kami</a>
            <a href="/berita" class="px-8 py-3 text-lg rounded-xl font-medium bg-white/60 hover:bg-white border-slate-200 text-slate-700 dark:bg-white/10 dark:hover:bg-white/20 dark:text-white border dark:border-white/10 flex items-center justify-center gap-2 shadow-sm transition-all backdrop-blur-sm"><i class="ph ph-newspaper"></i> Berita Terkini</a>
        </div>
    </section>

    <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="glass-card rounded-3xl p-8 flex flex-col items-center text-center">
            <div class="w-14 h-14 rounded-full bg-dentistry-100 dark:bg-brand-500/20 flex items-center justify-center mb-5 shadow-inner">
                <i class="ph ph-clock-counter-clockwise text-3xl text-dentistry-500 dark:text-brand-400"></i>
            </div>
            <h3 class="text-3xl font-bold text-slate-900 dark:text-white mb-2 transition-colors">Periode Aktif</h3>
            <p class="text-slate-500 dark:text-slate-400 font-medium"><%= DB.periods.find(p => p.status === 'ACTIVE').name %></p>
        </div>
        <div class="glass-card rounded-3xl p-8 flex flex-col items-center text-center">
            <div class="w-14 h-14 rounded-full bg-blue-100 dark:bg-blue-500/20 flex items-center justify-center mb-5 shadow-inner">
                <i class="ph ph-briefcase text-3xl text-blue-500 dark:text-blue-400"></i>
            </div>
            <h3 class="text-3xl font-bold text-slate-900 dark:text-white mb-2 transition-colors"><%= DB.programs.length %></h3>
            <p class="text-slate-500 dark:text-slate-400 font-medium">Program Kerja</p>
        </div>
        <div class="glass-card rounded-3xl p-8 flex flex-col items-center text-center">
            <div class="w-14 h-14 rounded-full bg-purple-100 dark:bg-purple-500/20 flex items-center justify-center mb-5 shadow-inner">
                <i class="ph ph-calendar-check text-3xl text-purple-500 dark:text-purple-400"></i>
            </div>
            <h3 class="text-3xl font-bold text-slate-900 dark:text-white mb-2 transition-colors"><%= DB.events ? DB.events.length : 0 %></h3>
            <p class="text-slate-500 dark:text-slate-400 font-medium">Agenda Mendatang</p>
        </div>
    </section>

    <section aria-labelledby="news-heading" class="pt-8">
        <div class="flex justify-between items-end mb-6">
            <div>
                <h2 id="news-heading" class="text-2xl font-bold text-slate-900 dark:text-white transition-colors">Berita Terbaru</h2>
                <p class="text-slate-500 dark:text-slate-400 mt-1">Informasi seputar aktivitas legislatif</p>
            </div>
            <a href="/berita" class="hidden sm:flex px-4 py-2 rounded-xl text-sm font-medium bg-white/50 hover:bg-white border border-slate-200 dark:border-transparent dark:bg-transparent dark:hover:bg-white/10 text-slate-600 dark:text-slate-300 hover:text-dentistry-600 dark:hover:text-white items-center gap-2 transition-colors shadow-sm dark:shadow-none">Lihat Semua <i class="ph ph-arrow-right"></i></a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <% DB.news.slice(0, 2).forEach(item => { %>
                <a href="/berita/<%= item.slug %>" class="glass-card rounded-3xl p-0 overflow-hidden group cursor-pointer block border border-slate-200/60 dark:border-white/10" aria-label="Baca berita: <%= item.title %>">
                    <div class="h-56 overflow-hidden relative">
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-900/90 via-slate-900/20 to-transparent z-10"></div>
                        <img src="<%= item.image %>" alt="<%= item.title %>" loading="lazy" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
                        <div class="absolute bottom-4 left-5 z-20">
                            <span class="px-3 py-1.5 text-xs font-bold tracking-wide rounded-full bg-dentistry-500 text-white shadow-md">Terkini</span>
                        </div>
                    </div>
                    <div class="p-6">
                        <p class="text-xs text-slate-500 dark:text-slate-400 mb-3 flex items-center gap-2 font-medium"><i class="ph ph-calendar-blank text-dentistry-500 dark:text-brand-400"></i> <%= item.date %></p>
                        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3 leading-snug group-hover:text-dentistry-600 dark:group-hover:text-brand-400 transition-colors"><%= item.title %></h3>
                        <p class="text-slate-600 dark:text-slate-400 text-sm line-clamp-2 leading-relaxed"><%= item.excerpt %></p>
                    </div>
                </a>
            <% }) %>
        </div>
    </section>
</div>

<%- include('partials/footer') %>
