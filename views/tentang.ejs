<%- include('partials/header') %>

<article class="space-y-8 animate-fade-in pt-8 relative z-10">
    <header class="text-center max-w-3xl mx-auto mb-12">
        <span class="px-2.5 py-1 text-xs font-semibold rounded-full border bg-green-500/20 text-green-300 border-green-500/30">Profil Lembaga</span>
        <h1 class="text-4xl font-bold mt-4 mb-4 text-white">Tentang <%= DB.organization.name %></h1>
        <p class="text-slate-300 leading-relaxed"><%= DB.organization.description %></p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <section class="glass-card rounded-2xl p-6">
            <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-lg bg-blue-500/20 flex items-center justify-center text-blue-400"><i class="ph ph-target text-xl"></i></div>
                <h2 class="text-xl font-bold text-white">Visi</h2>
            </div>
            <p class="text-slate-300 italic">"<%= DB.organization.vision %>"</p>
        </section>
        <section class="glass-card rounded-2xl p-6">
            <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-lg bg-brand-500/20 flex items-center justify-center text-brand-400"><i class="ph ph-list-checks text-xl"></i></div>
                <h2 class="text-xl font-bold text-white">Misi</h2>
            </div>
            <ul class="space-y-3">
                <% DB.organization.mission.forEach(m => { %>
                    <li class="flex gap-3 text-slate-300">
                        <i class="ph ph-check-circle text-brand-500 mt-1 shrink-0"></i>
                        <span><%= m %></span>
                    </li>
                <% }) %>
            </ul>
        </section>
    </div>

    <section>
        <h2 class="text-2xl font-bold mt-12 mb-6 text-white">Histori Kepengurusan</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            <% DB.periods.forEach(period => { %>
                <div class="glass-card rounded-2xl p-6 flex items-center justify-between">
                    <div>
                        <h3 class="font-semibold text-lg text-white"><%= period.name %></h3>
                        <p class="text-sm text-slate-400">Database Tersimpan</p>
                    </div>
                    <% if(period.status === 'ACTIVE') { %>
                        <span class="px-2.5 py-1 text-xs font-semibold rounded-full border bg-green-500/20 text-green-300 border-green-500/30">ACTIVE</span>
                    <% } else { %>
                        <span class="px-2.5 py-1 text-xs font-semibold rounded-full border bg-slate-500/20 text-slate-300 border-slate-500/30">ARCHIVED</span>
                    <% } %>
                </div>
            <% }) %>
        </div>
    </section>
</article>

<%- include('partials/footer') %>