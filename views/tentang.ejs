<%- include('partials/header') %>

<article class="space-y-12 animate-fade-in relative z-10">
    <!-- Header Profil -->
    <header class="text-center max-w-4xl mx-auto mb-16 relative">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-64 h-64 bg-cyan-500/20 blur-[100px] -z-10 rounded-full"></div>
        <span class="px-4 py-2 text-sm font-black rounded-full neu-inset text-[var(--brand-primary)] uppercase tracking-widest shadow-inner">
            <i class="ph ph-fingerprint mr-2"></i> Identitas Lembaga
        </span>
        <h1 class="text-5xl md:text-7xl font-black mt-8 mb-6 holographic-text drop-shadow-lg">Platform Parlemen Mahasiswa</h1>
        <p class="text-xl text-[var(--text-muted)] font-medium leading-relaxed"><%= DB.organization.description %></p>
    </header>

    <!-- Visi Misi Neumorphism -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <section class="neu-flat p-10 relative overflow-hidden group">
            <div class="absolute -right-10 -top-10 w-40 h-40 bg-blue-500/10 rounded-full blur-2xl group-hover:scale-150 transition-transform duration-700"></div>
            <div class="flex items-center gap-4 mb-6">
                <div class="w-14 h-14 rounded-2xl neu-inset flex items-center justify-center text-[var(--brand-primary)]">
                    <i class="ph ph-target text-3xl"></i>
                </div>
                <h2 class="text-3xl font-black text-[var(--text-main)]">Visi Utama</h2>
            </div>
            <p class="text-[var(--text-muted)] text-lg leading-relaxed italic font-medium relative z-10 border-l-4 border-[var(--brand-primary)] pl-6">
                "<%= DB.organization.vision %>"
            </p>
        </section>
        
        <section class="neu-flat p-10 relative overflow-hidden group">
            <div class="absolute -left-10 -bottom-10 w-40 h-40 bg-cyan-500/10 rounded-full blur-2xl group-hover:scale-150 transition-transform duration-700"></div>
            <div class="flex items-center gap-4 mb-6">
                <div class="w-14 h-14 rounded-2xl neu-inset flex items-center justify-center text-cyan-500">
                    <i class="ph ph-rocket-launch text-3xl"></i>
                </div>
                <h2 class="text-3xl font-black text-[var(--text-main)]">Misi Pergerakan</h2>
            </div>
            <ul class="space-y-4 relative z-10">
                <% DB.organization.mission.forEach(m => { %>
                    <li class="flex gap-4 items-start neu-inset p-4 rounded-xl">
                        <div class="mt-1 bg-[var(--brand-primary)] rounded-full p-1 shadow-[0_0_10px_rgba(14,165,233,0.5)]">
                            <i class="ph ph-check-bold text-white text-sm"></i>
                        </div>
                        <span class="text-[var(--text-main)] font-medium"><%= m %></span>
                    </li>
                <% }) %>
            </ul>
        </section>
    </div>

    <!-- Histori (Glass Cards) -->
    <section class="pt-8">
        <h2 class="text-3xl font-black mb-8 text-[var(--text-main)] flex items-center gap-3">
            <i class="ph ph-clock-counter-clockwise text-[var(--brand-primary)]"></i> Arsip Kepengurusan
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <% DB.periods.forEach(period => { %>
                <div class="glass-card p-6 flex flex-col justify-between group">
                    <div class="flex justify-between items-start mb-4">
                        <div class="w-12 h-12 rounded-xl neu-inset flex items-center justify-center text-[var(--text-muted)] group-hover:text-[var(--brand-primary)] transition-colors">
                            <i class="ph ph-archive text-2xl"></i>
                        </div>
                        <% if(period.status === 'ACTIVE') { %>
                            <span class="px-3 py-1 text-xs font-black rounded-lg bg-green-500 text-white shadow-[0_0_15px_rgba(34,197,94,0.4)] animate-pulse">AKTIF</span>
                        <% } else { %>
                            <span class="px-3 py-1 text-xs font-bold rounded-lg neu-inset text-[var(--text-muted)]">ARSIP</span>
                        <% } %>
                    </div>
                    <div>
                        <h3 class="font-black text-xl text-[var(--text-main)]"><%= period.name %></h3>
                        <p class="text-sm font-medium text-[var(--text-muted)] mt-1">Database Tersimpan</p>
                    </div>
                </div>
            <% }) %>
        </div>
    </section>
</article>

<%- include('partials/footer') %>
