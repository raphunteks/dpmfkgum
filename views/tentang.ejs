<%- include('partials/header') %>

<article class="space-y-8 animate-fade-in pt-8 relative z-10">
    <header class="text-center max-w-3xl mx-auto mb-14">
        <span class="px-3 py-1 text-xs font-semibold rounded-full border bg-dentistry-100 text-dentistry-600 border-dentistry-200 dark:bg-green-500/20 dark:text-green-300 dark:border-green-500/30 transition-colors">Profil Lembaga</span>
        <h1 class="text-4xl md:text-5xl font-extrabold mt-6 mb-4 text-slate-900 dark:text-white transition-colors">Tentang <%= DB.organization.name %></h1>
        <p class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed transition-colors"><%= DB.organization.description %></p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <section class="glass-card rounded-3xl p-8">
            <div class="flex items-center gap-4 mb-6 pb-4 border-b border-slate-200 dark:border-white/10 transition-colors">
                <div class="w-12 h-12 rounded-xl bg-blue-100 dark:bg-blue-500/20 flex items-center justify-center text-blue-500 dark:text-blue-400 shadow-inner"><i class="ph ph-target text-2xl"></i></div>
                <h2 class="text-2xl font-bold text-slate-900 dark:text-white transition-colors">Visi</h2>
            </div>
            <p class="text-slate-700 dark:text-slate-300 italic text-lg leading-relaxed font-medium transition-colors">"<%= DB.organization.vision %>"</p>
        </section>
        
        <section class="glass-card rounded-3xl p-8">
            <div class="flex items-center gap-4 mb-6 pb-4 border-b border-slate-200 dark:border-white/10 transition-colors">
                <div class="w-12 h-12 rounded-xl bg-dentistry-100 dark:bg-brand-500/20 flex items-center justify-center text-dentistry-500 dark:text-brand-400 shadow-inner"><i class="ph ph-list-checks text-2xl"></i></div>
                <h2 class="text-2xl font-bold text-slate-900 dark:text-white transition-colors">Misi</h2>
            </div>
            <ul class="space-y-4">
                <% DB.organization.mission.forEach(m => { %>
                    <li class="flex gap-4 text-slate-700 dark:text-slate-300 bg-white/40 dark:bg-transparent p-3 rounded-xl border border-transparent dark:border-white/5 shadow-sm dark:shadow-none transition-colors">
                        <i class="ph-fill ph-check-circle text-dentistry-500 dark:text-brand-500 text-xl mt-0.5 shrink-0"></i>
                        <span class="leading-relaxed"><%= m %></span>
                    </li>
                <% }) %>
            </ul>
        </section>
    </div>

    <section class="pt-8">
        <h2 class="text-2xl font-bold mt-8 mb-6 text-slate-900 dark:text-white transition-colors">Histori Kepengurusan</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            <% DB.periods.forEach(period => { %>
                <div class="glass-card rounded-2xl p-6 flex items-center justify-between border border-slate-200/50 dark:border-white/10 hover:border-dentistry-300 dark:hover:border-brand-500/50 transition-all">
                    <div>
                        <h3 class="font-bold text-lg text-slate-900 dark:text-white transition-colors"><%= period.name %></h3>
                        <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">Database Tersimpan</p>
                    </div>
                    <% if(period.status === 'ACTIVE') { %>
                        <span class="px-3 py-1 text-xs font-bold rounded-full bg-dentistry-500 text-white shadow-md">ACTIVE</span>
                    <% } else { %>
                        <span class="px-3 py-1 text-xs font-semibold rounded-full border bg-slate-100 text-slate-600 border-slate-300 dark:bg-slate-800 dark:text-slate-400 dark:border-slate-700 transition-colors">ARCHIVED</span>
                    <% } %>
                </div>
            <% }) %>
        </div>
    </section>
</article>

<%- include('partials/footer') %>
