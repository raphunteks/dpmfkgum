<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- 🚀 MASTERPIECE SEO METADATA (DINAMIS DARI SERVER.JS) -->
    <title><%= seo.title %></title>
    <meta name="description" content="<%= seo.description %>">
    <link rel="canonical" href="<%= seo.canonical %>">
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">

    <!-- 🌐 FAVICON LOGO WEB DINAMIS -->
    <link rel="icon" href="/img/logo-dpm.png" type="image/png">
    <link rel="apple-touch-icon" href="/img/logo-dpm.png">

    <!-- Open Graph / Facebook / WhatsApp Preview -->
    <meta property="og:type" content="<%= seo.type || 'website' %>">
    <meta property="og:title" content="<%= seo.title %>">
    <meta property="og:description" content="<%= seo.description %>">
    <meta property="og:image" content="<%= seo.ogImage %>">
    <meta property="og:url" content="<%= seo.canonical %>">
    <meta property="og:site_name" content="<%= DB.organization.name %>">
    
    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= seo.title %>">
    <meta name="twitter:description" content="<%= seo.description %>">
    <meta name="twitter:image" content="<%= seo.ogImage %>">

    <!-- 🌐 JSON-LD STRUCTURED DATA (GSC GOLD STANDARD) -->
    <% if (seo.structuredData) { %>
    <script type="application/ld+json">
        <%- JSON.stringify(seo.structuredData) %>
    </script>
    <% } %>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/main.css">
    
    <!-- Security Script -->
    <script src="/js/protect-devtools.js"></script>

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    colors: {
                        brand: { 50: '#f0fdf4', 100: '#dcfce7', 500: '#22c55e', 600: '#16a34a', 900: '#14532d' }
                    },
                    animation: { 'fade-in': 'fadeIn 0.5s ease-out forwards' },
                    keyframes: {
                        fadeIn: { '0%': { opacity: '0', transform: 'translateY(10px)' }, '100%': { opacity: '1', transform: 'translateY(0)' } }
                    }
                }
            }
        }

        // Theme Logic Init
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>
</head>
<body class="transition-colors duration-500">
    <div class="bg-mesh"></div>
    <div class="fixed top-0 left-1/4 w-96 h-96 bg-[var(--brand-primary)] rounded-full mix-blend-screen filter blur-[100px] pointer-events-none opacity-20"></div>
    <div class="fixed bottom-0 right-1/4 w-96 h-96 bg-cyan-500 rounded-full mix-blend-screen filter blur-[100px] pointer-events-none opacity-20"></div>

    <header>
        <nav class="fixed top-0 w-full z-50 glass-nav transition-all duration-300 py-3">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between items-center h-16">
                    
                    <a href="/" class="flex items-center gap-4 group cursor-pointer" aria-label="Beranda Utama">
                        <div class="w-12 h-12 rounded-2xl neu-flat flex items-center justify-center overflow-hidden relative group-hover:scale-105 transition-transform">
                            <div class="absolute inset-0 bg-gradient-to-tr from-cyan-400 to-blue-500 opacity-20 group-hover:opacity-40 transition-opacity"></div>
                            <img src="/img/logo-dpm.png" alt="Logo DPM" class="w-8 h-8 object-contain drop-shadow-md z-10">
                        </div>
                        <div>
                            <span class="font-extrabold text-xl leading-tight tracking-tight block holographic-text">DPM KBMFKG</span>
                            <span class="text-xs text-[var(--text-muted)] font-medium block">Universitas Muslim Indonesia</span>
                        </div>
                    </a>

                    <div class="hidden md:flex items-center p-1 rounded-full neu-inset">
                        <a href="/" class="px-5 py-2 rounded-full text-sm font-semibold transition-all duration-300 flex items-center gap-2 <%= path === '/' ? 'bg-[var(--brand-primary)] text-white shadow-lg' : 'text-[var(--text-muted)] hover:text-[var(--text-main)]' %>"><i class="ph ph-house text-lg"></i> Beranda</a>
                        <a href="/tentang" class="px-5 py-2 rounded-full text-sm font-semibold transition-all duration-300 flex items-center gap-2 <%= path === '/tentang' ? 'bg-[var(--brand-primary)] text-white shadow-lg' : 'text-[var(--text-muted)] hover:text-[var(--text-main)]' %>"><i class="ph ph-users text-lg"></i> Organisasi</a>
                        <a href="/program-kerja" class="px-5 py-2 rounded-full text-sm font-semibold transition-all duration-300 flex items-center gap-2 <%= path === '/program-kerja' ? 'bg-[var(--brand-primary)] text-white shadow-lg' : 'text-[var(--text-muted)] hover:text-[var(--text-main)]' %>"><i class="ph ph-briefcase text-lg"></i> Program Kerja</a>
                        <a href="/berita" class="px-5 py-2 rounded-full text-sm font-semibold transition-all duration-300 flex items-center gap-2 <%= path === '/berita' ? 'bg-[var(--brand-primary)] text-white shadow-lg' : 'text-[var(--text-muted)] hover:text-[var(--text-main)]' %>"><i class="ph ph-newspaper text-lg"></i> Berita</a>
                        <a href="/our-team" class="px-5 py-2 rounded-full text-sm font-semibold transition-all duration-300 flex items-center gap-2 <%= path === '/our-team' ? 'bg-[var(--brand-primary)] text-white shadow-lg' : 'text-[var(--text-muted)] hover:text-[var(--text-main)]' %>"><i class="ph ph-star text-lg"></i> Our Team</a>
                    </div>

                    <div class="hidden md:flex items-center gap-6">
                        <div class="theme-icon-wrapper flex items-center gap-3">
                            <i class="ph ph-sun-dim text-2xl text-amber-500 drop-shadow-[0_0_8px_rgba(245,158,11,0.5)]"></i>
                            <input type="checkbox" id="theme-toggle" class="theme-toggle" aria-label="Toggle Dark Mode">
                        </div>
                        <a href="/admin" class="px-5 py-2.5 rounded-xl font-bold transition-all duration-300 flex items-center justify-center gap-2 neu-flat text-[var(--text-main)] hover:text-[var(--brand-primary)]">
                            <i class="ph ph-sign-in text-xl"></i> Admin
                        </a>
                    </div>

                    <div class="md:hidden flex items-center gap-4">
                        <div class="theme-icon-wrapper flex items-center">
                            <input type="checkbox" id="mobile-theme-toggle" class="theme-toggle scale-75" aria-label="Toggle Dark Mode">
                        </div>
                        <button id="mobile-menu-btn" class="text-[var(--text-main)] hover:text-[var(--brand-primary)] p-2 neu-flat rounded-lg" aria-label="Buka Menu Navigasi">
                            <i class="ph ph-list text-2xl" id="menu-icon"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div id="mobile-menu" class="hidden md:hidden glass-nav border-t border-[var(--glass-border)] absolute w-full animate-fade-in shadow-2xl mt-3">
                <div class="px-4 pt-4 pb-8 space-y-3">
                    <a href="/" class="w-full text-left px-4 py-3 rounded-xl flex items-center gap-3 <%= path === '/' ? 'bg-[var(--brand-primary)] text-white shadow-md' : 'text-[var(--text-muted)] hover:bg-[var(--glass-bg)] hover:text-[var(--text-main)]' %> font-medium"><i class="ph ph-house text-xl"></i> Beranda</a>
                    <a href="/tentang" class="w-full text-left px-4 py-3 rounded-xl flex items-center gap-3 <%= path === '/tentang' ? 'bg-[var(--brand-primary)] text-white shadow-md' : 'text-[var(--text-muted)] hover:bg-[var(--glass-bg)] hover:text-[var(--text-main)]' %> font-medium"><i class="ph ph-users text-xl"></i> Organisasi</a>
                    <a href="/program-kerja" class="w-full text-left px-4 py-3 rounded-xl flex items-center gap-3 <%= path === '/program-kerja' ? 'bg-[var(--brand-primary)] text-white shadow-md' : 'text-[var(--text-muted)] hover:bg-[var(--glass-bg)] hover:text-[var(--text-main)]' %> font-medium"><i class="ph ph-briefcase text-xl"></i> Program Kerja</a>
                    <a href="/berita" class="w-full text-left px-4 py-3 rounded-xl flex items-center gap-3 <%= path === '/berita' ? 'bg-[var(--brand-primary)] text-white shadow-md' : 'text-[var(--text-muted)] hover:bg-[var(--glass-bg)] hover:text-[var(--text-main)]' %> font-medium"><i class="ph ph-newspaper text-xl"></i> Berita</a>
                    <a href="/our-team" class="w-full text-left px-4 py-3 rounded-xl flex items-center gap-3 <%= path === '/our-team' ? 'bg-[var(--brand-primary)] text-white shadow-md' : 'text-[var(--text-muted)] hover:bg-[var(--glass-bg)] hover:text-[var(--text-main)]' %> font-medium"><i class="ph ph-star text-xl"></i> Our Team</a>
                    <div class="h-px bg-[var(--glass-border)] my-4"></div>
                    <a href="/admin" class="w-full text-left px-4 py-3 rounded-xl neu-flat text-[var(--text-main)] flex items-center gap-3 font-bold justify-center"><i class="ph ph-sign-in text-xl"></i> Login Admin</a>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow pt-32 pb-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full min-h-screen relative z-10">

    <script>
        function initThemeToggle(toggleId) {
            const toggleBtn = document.getElementById(toggleId);
            if(!toggleBtn) return;
            
            if(document.documentElement.classList.contains('dark')) {
                toggleBtn.checked = true;
            }

            toggleBtn.addEventListener('change', function() {
                document.querySelectorAll('.theme-toggle').forEach(btn => btn.checked = this.checked);
                document.body.style.opacity = '0.5'; 
                setTimeout(() => {
                    if (this.checked) {
                        document.documentElement.classList.add('dark');
                        localStorage.setItem('theme', 'dark');
                    } else {
                        document.documentElement.classList.remove('dark');
                        localStorage.setItem('theme', 'light');
                    }
                    document.body.style.opacity = '1';
                }, 150);
            });
        }

        initThemeToggle('theme-toggle');
        initThemeToggle('mobile-theme-toggle');

        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const menuIcon = document.getElementById('menu-icon');

        if(mobileMenuBtn) {
            mobileMenuBtn.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
                if(mobileMenu.classList.contains('hidden')) {
                    menuIcon.classList.remove('ph-x');
                    menuIcon.classList.add('ph-list');
                } else {
                    menuIcon.classList.remove('ph-list');
                    menuIcon.classList.add('ph-x');
                }
            });
        }
    </script>
