<%- include('partials/header') %>

<div class="space-y-10 animate-fade-in pt-4 relative z-10">
    <header class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-12 border-b border-[var(--glass-border)] pb-8">
        <div>
            <h1 class="text-5xl font-black mb-4 holographic-text inline-block">Program Kerja</h1>
            <p class="text-xl font-medium text-[var(--text-muted)]">Blueprint realisasi pergerakan legislatif mahasiswa.</p>
        </div>
        
        <!-- Neumorphic Dropdown -->
        <div class="relative">
            <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-[var(--brand-primary)]">
                <i class="ph-bold ph-caret-down"></i>
            </div>
            <select class="neu-inset appearance-none w-full md:w-64 pl-6 pr-12 py-4 rounded-2xl text-sm font-bold text-[var(--text-main)] outline-none focus:ring-2 focus:ring-[var(--brand-primary)] transition-shadow cursor-pointer" aria-label="Filter Status">
                <option value="" class="font-bold">Semua Status Proker</option>
                <option value="PLANNED" class="font-bold">Direncanakan (Planned)</option>
                <option value="ONGOING" class="font-bold">Sedang Berjalan (Ongoing)</option>
                <option value="COMPLETED" class="font-bold">Selesai (Completed)</option>
            </select>
        </div>
    </header>

    <% if (DB.programs && DB.programs.length > 0) { %>
        <div class="space-y-6" role="list">
            <% DB.programs.forEach(prog => { %>
                <article class="glass-card p-6 md:p-8 flex flex-col sm:flex-row gap-6 justify-between items-start sm:items-center group" role="listitem">
                    <div class="flex-1">
                        <div class="flex flex-wrap items-center gap-4 mb-3">
                            <div class="w-10 h-10 rounded-xl neu-inset flex items-center justify-center text-[var(--brand-primary)]">
                                <i class="ph ph-kanban text-xl"></i>
                            </div>
                            <h2 class="text-2xl font-black text-[var(--text-main)]"><%= prog.name %></h2>
                            
                            <% if(prog.status === 'ONGOING') { %>
                                <span class="px-3 py-1.5 text-xs font-black uppercase tracking-wider rounded-lg bg-blue-500/20 text-blue-600 dark:text-blue-400 border border-blue-500/30 animate-pulse">ONGOING</span>
                            <% } else if(prog.status === 'COMPLETED') { %>
                                <span class="px-3 py-1.5 text-xs font-black uppercase tracking-wider rounded-lg bg-green-500/20 text-green-600 dark:text-green-400 border border-green-500/30">COMPLETED</span>
                            <% } else { %>
                                <span class="px-3 py-1.5 text-xs font-black uppercase tracking-wider rounded-lg neu-inset text-[var(--text-muted)]"><%= prog.status %></span>
                            <% } %>
                        </div>
                        
                        <p class="text-[var(--text-muted)] text-base font-medium mb-4 pl-14"><%= prog.description %></p>
                        
                        <div class="pl-14 flex items-center gap-6">
                            <p class="text-xs font-bold uppercase tracking-wider text-[var(--text-main)] flex items-center gap-2">
                                <i class="ph ph-target text-[var(--brand-primary)] text-lg"></i> Sasaran: <span class="text-[var(--text-muted)]"><%= prog.target %></span>
                            </p>
                        </div>
                    </div>
                    
                    <a href="/program-kerja/<%= prog.slug %>" class="px-8 py-4 rounded-xl text-sm font-bold transition-all neu-flat text-[var(--text-main)] hover:text-white hover:bg-[var(--brand-primary)] shrink-0 text-center w-full md:w-auto shadow-lg flex items-center justify-center gap-2">
                        Analisis Detail <i class="ph ph-arrow-right"></i>
                    </a>
                </article>
            <% }) %>
        </div>
    <% } else { %>
        <!-- Empty State UI Holographic -->
        <div class="flex flex-col items-center justify-center py-20 text-center neu-flat">
            <div class="w-32 h-32 rounded-full neu-inset flex items-center justify-center mb-6">
                <i class="ph ph-folder-dashed text-6xl text-[var(--brand-primary)] opacity-50"></i>
            </div>
            <h2 class="text-2xl font-black text-[var(--text-main)] mb-2">Belum Ada Program Kerja</h2>
            <p class="text-[var(--text-muted)] font-medium max-w-md">Data program kerja belum diinisialisasi oleh administrator untuk periode saat ini.</p>
        </div>
    <% } %>
</div>

<%- include('partials/footer') %>
