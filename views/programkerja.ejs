<%- include('partials/header') %>

<div class="space-y-8 animate-fade-in pt-8 relative z-10">
    <header class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-bold mb-2 text-white">Program Kerja</h1>
            <p class="text-slate-400">Daftar program dan realisasi legislatif periode berjalan.</p>
        </div>
        <select class="glass rounded-xl px-4 py-2 text-sm text-white outline-none appearance-none border-white/20" aria-label="Filter Status Program">
            <option value="" class="bg-slate-800">Semua Status</option>
            <option value="PLANNED" class="bg-slate-800">Direncanakan</option>
            <option value="ONGOING" class="bg-slate-800">Berjalan</option>
            <option value="COMPLETED" class="bg-slate-800">Selesai</option>
        </select>
    </header>

    <div class="space-y-4" role="list">
        <% DB.programs.forEach(prog => { %>
            <article class="glass-card rounded-2xl p-6 flex flex-col sm:flex-row gap-6 justify-between items-start sm:items-center hover:bg-white/5 transition-colors" role="listitem">
                <div class="flex-1">
                    <div class="flex flex-wrap items-center gap-3 mb-2">
                        <h2 class="text-xl font-bold text-white"><%= prog.name %></h2>
                        
                        <% if(prog.status === 'ONGOING') { %>
                            <span class="px-2.5 py-1 text-xs font-semibold rounded-full border bg-blue-500/20 text-blue-300 border-blue-500/30">ONGOING</span>
                        <% } else if(prog.status === 'COMPLETED') { %>
                            <span class="px-2.5 py-1 text-xs font-semibold rounded-full border bg-brand-500/20 text-brand-300 border-brand-500/30">COMPLETED</span>
                        <% } else { %>
                            <span class="px-2.5 py-1 text-xs font-semibold rounded-full border bg-amber-500/20 text-amber-300 border-amber-500/30"><%= prog.status %></span>
                        <% } %>
                    </div>
                    <p class="text-slate-300 text-sm mb-2"><%= prog.description %></p>
                    <p class="text-xs text-slate-500 flex items-center gap-2"><i class="ph ph-users"></i> Sasaran: <%= prog.target %></p>
                </div>
                <a href="/program-kerja/<%= prog.slug %>" class="px-4 py-2 rounded-xl text-sm font-medium transition-all bg-white/10 hover:bg-white/20 text-white border border-white/10 shrink-0 text-center w-full md:w-auto">Lihat Detail</a>
            </article>
        <% }) %>
    </div>
</div>

<%- include('partials/footer') %>