<%- include('partials/header') %>

<div class="space-y-8 animate-fade-in pt-8 relative z-10">
    <header class="border-b border-slate-200 dark:border-white/10 pb-6 mb-8 transition-colors">
        <h1 class="text-3xl md:text-4xl font-extrabold mb-3 text-slate-900 dark:text-white transition-colors">Pusat Informasi & Berita</h1>
        <p class="text-lg text-slate-600 dark:text-slate-400 transition-colors">Publikasi resmi dan dokumentasi kegiatan KBMFKG UMI.</p>
    </header>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% DB.news.forEach(item => { %>
            <a href="/berita/<%= item.slug %>" class="glass-card rounded-3xl p-0 overflow-hidden flex flex-col group border border-slate-200/60 dark:border-white/10 hover:border-dentistry-300 dark:hover:border-brand-500/50 transition-all shadow-sm" aria-label="Baca berita: <%= item.title %>">
                <div class="h-52 overflow-hidden relative bg-slate-100 dark:bg-slate-800">
                    <img src="<%= item.image %>" alt="<%= item.title %>" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10"></div>
                </div>
                <div class="p-6 flex-1 flex flex-col bg-white/40 dark:bg-transparent">
                    <span class="px-3 py-1 text-[10px] uppercase font-bold tracking-wider rounded-full border bg-dentistry-50 text-dentistry-600 border-dentistry-200 dark:bg-emerald-500/20 dark:text-emerald-300 dark:border-emerald-500/30 self-start mb-4 transition-colors"><%= item.status %></span>
                    
                    <h2 class="text-xl font-bold mb-3 leading-snug text-slate-900 dark:text-white group-hover:text-dentistry-600 dark:group-hover:text-brand-400 transition-colors line-clamp-2"><%= item.title %></h2>
                    
                    <p class="text-sm text-slate-600 dark:text-slate-400 mb-5 flex-1 line-clamp-3 leading-relaxed transition-colors"><%= item.excerpt %></p>
                    
                    <div class="border-t border-slate-200 dark:border-white/10 pt-4 flex items-center justify-between transition-colors">
                        <time datetime="<%= item.date %>" class="text-xs font-medium text-slate-500 dark:text-slate-400 flex items-center gap-1.5"><i class="ph ph-calendar-blank text-dentistry-500 dark:text-brand-400"></i> <%= item.date %></time>
                        <span class="text-xs font-semibold text-dentistry-600 dark:text-brand-400 opacity-0 group-hover:opacity-100 transition-opacity flex items-center gap-1">Baca <i class="ph ph-arrow-right"></i></span>
                    </div>
                </div>
            </a>
        <% }) %>
    </div>
</div>

<%- include('partials/footer') %>
