  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Theme Management
    function applyTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      localStorage.setItem('dpm_theme', theme);
      const icon = document.getElementById('themeIconNav');
      if (icon) icon.className = theme === 'dark' ? 'bi bi-sun-fill text-warning' : 'bi bi-moon-stars';
    }
    const savedTheme = localStorage.getItem('dpm_theme') || 'light';
    applyTheme(savedTheme);

    function toggleTheme() {
      const current = document.documentElement.getAttribute('data-theme') || 'light';
      applyTheme(current === 'dark' ? 'light' : 'dark');
    }

    // Reading Progress Indicator
    window.addEventListener('scroll', () => {
      const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
      const bar = document.getElementById('readingProgressBar');
      if (bar) bar.style.width = scrolled + '%';
    });

    // Share Functions
    const currentUrl = window.location.href;
    const currentTitle = document.title;

    function shareWa() {
      const u = `https://api.whatsapp.com/send?text=${encodeURIComponent(currentTitle + ' ' + currentUrl)}`;
      window.open(u, '_blank');
    }
    function shareTg() {
      const u = `https://t.me/share/url?url=${encodeURIComponent(currentUrl)}&text=${encodeURIComponent(currentTitle)}`;
      window.open(u, '_blank');
    }
    function shareX() {
      const u = `https://twitter.com/intent/tweet?url=${encodeURIComponent(currentUrl)}&text=${encodeURIComponent(currentTitle)}`;
      window.open(u, '_blank');
    }
    function copyArticleLink() {
      navigator.clipboard.writeText(currentUrl).then(() => {
        const toastEl = document.getElementById('liveToast');
        if (toastEl) new bootstrap.Toast(toastEl).show();
      });
    }
  </script>
