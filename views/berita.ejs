<%- include('partials/header') %>

<div class="space-y-10 animate-fade-in pt-4 relative z-10">
    <header class="text-center md:text-left border-b border-[var(--glass-border)] pb-8">
        <h1 class="text-5xl font-black mb-4 holographic-text inline-block">Newsroom Eksekutif</h1>
        <p class="text-xl font-medium text-[var(--text-muted)] max-w-2xl">Dokumentasi komprehensif, liputan kegiatan, dan publikasi resmi DPM KBMFKG UMI.</p>
    </header>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-12">
        <% DB.news.forEach(item => { %>
            <a href="/berita/<%= item.slug %>" class="neu-flat overflow-hidden flex flex-col group relative" aria-label="Baca berita: <%= item.title %>">
                <!-- Floating Holographic Badge -->
                <div class="absolute top-4 right-4 z-30">
                    <span class="px-4 py-1.5 text-xs font-black rounded-xl glass-card text-[var(--text-main)] shadow-lg backdrop-blur-md uppercase tracking-wider"><%= item.status %></span>
                </div>

                <div class="h-56 overflow-hidden p-3 relative">
                    <div class="w-full h-full rounded-2xl overflow-hidden relative neu-inset">
                        <img src="<%= item.image %>" alt="Cover: <%= item.title %>" loading="lazy" class="w-full h-full object-cover group-hover:scale-125 group-hover:rotate-2 transition-all duration-1000 ease-in-out opacity-90 group-hover:opacity-100" />
                        <div class="absolute inset-0 bg-gradient-to-t from-[var(--bg-base)] via-transparent to-transparent opacity-80"></div>
                    </div>
                </div>
                
                <div class="p-6 flex-1 flex flex-col relative z-20">
                    <div class="flex items-center gap-2 mb-3">
                        <div class="w-8 h-8 rounded-full neu-inset flex items-center justify-center">
                            <i class="ph ph-newspaper-clipping text-[var(--brand-primary)]"></i>
                        </div>
                        <time datetime="<%= item.date %>" class="text-xs font-bold uppercase tracking-wider text-[var(--text-muted)]"><%= item.date %></time>
                    </div>
                    
                    <h2 class="text-xl font-black mb-3 leading-snug text-[var(--text-main)] group-hover:text-[var(--brand-primary)] transition-colors"><%= item.title %></h2>
                    <p class="text-sm font-medium text-[var(--text-muted)] mb-6 flex-1 line-clamp-3 leading-relaxed"><%= item.excerpt %></p>
                    
                    <div class="pt-4 border-t border-[var(--glass-border)] flex items-center justify-between text-sm font-bold text-[var(--brand-primary)]">
                        Baca Selengkapnya
                        <i class="ph ph-arrow-right group-hover:translate-x-2 transition-transform"></i>
                    </div>
                </div>
            </a>
        <% }) %>
    </div>
</div>

<%- include('partials/footer') %>
