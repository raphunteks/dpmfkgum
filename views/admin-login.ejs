<%- include('partials/header') %>

<div class="flex flex-col items-center justify-center min-h-[75vh] relative z-10 animate-fade-in">
    <div class="w-full max-w-md">
        <!-- Floating Logo Icon -->
        <div class="w-24 h-24 mx-auto mb-8 rounded-3xl neu-flat flex items-center justify-center animate-float">
            <i class="ph ph-fingerprint text-5xl holographic-text"></i>
        </div>
        
        <!-- Login Form Glass Card -->
        <div class="glass-card p-10">
            <div class="text-center mb-8">
                <h1 class="text-3xl font-black text-[var(--text-main)] tracking-tight">Access Control</h1>
                <p class="text-[var(--text-muted)] font-medium mt-2">Masukan kredensial administrator sistem</p>
            </div>
            
            <% if(error) { %>
                <div class="mb-6 p-4 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-500 text-sm font-bold flex items-center gap-3 animate-fade-in">
                    <i class="ph ph-warning-circle text-xl"></i>
                    <%= error %>
                </div>
            <% } %>

            <form action="/admin/login" method="POST" class="space-y-6">
                <div>
                    <label for="username" class="block text-xs font-black uppercase tracking-widest text-[var(--text-muted)] mb-2 pl-2">Identitas User</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i class="ph ph-user text-lg text-[var(--text-muted)]"></i>
                        </div>
                        <input type="text" id="username" name="username" required autocomplete="off" 
                            class="neu-input w-full pl-12 pr-4 py-4 rounded-xl text-sm font-bold focus:ring-2 focus:ring-[var(--brand-primary)]" 
                            placeholder="Masukan Username">
                    </div>
                </div>
                
                <div>
                    <label for="password" class="block text-xs font-black uppercase tracking-widest text-[var(--text-muted)] mb-2 pl-2">Passphrase Sandi</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i class="ph ph-lock-key text-lg text-[var(--text-muted)]"></i>
                        </div>
                        <input type="password" id="password" name="password" required 
                            class="neu-input w-full pl-12 pr-4 py-4 rounded-xl text-sm font-bold focus:ring-2 focus:ring-[var(--brand-primary)]" 
                            placeholder="••••••••••••">
                    </div>
                </div>

                <button type="submit" class="w-full mt-4 py-4 rounded-xl font-bold bg-[var(--brand-primary)] text-white shadow-[0_10px_30px_rgba(14,165,233,0.4)] hover:shadow-[0_15px_40px_rgba(14,165,233,0.6)] transition-all hover:-translate-y-1 flex items-center justify-center gap-2">
                    <i class="ph ph-sign-in text-lg"></i> Otorisasi Masuk
                </button>
            </form>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
