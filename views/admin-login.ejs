<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login Backoffice Parlemen - DPM KBMFKG UMI</title>
  <meta name="description" content="Portal Otentikasi Khusus Anggota Dewan Perwakilan Mahasiswa KBMFKG UMI">
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" type="image/webp" href="/dpmfkgumi.webp">
  <link rel="apple-touch-icon" href="/dpmfkgumi.webp">
  
  <!-- Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

  <style>
    :root {
      --primary-900: #022c22;
      --primary-800: #064e3b;
      --primary-700: #047857;
      --primary-600: #059669;
      --primary-500: #10b981;
      --gold-500: #f59e0b;
      --surface-light: #ffffff;
      --bg-light: #f8fafc;
      --text-main: #0f172a;
      --text-muted: #64748b;
      --border-color: rgba(226, 232, 240, 0.8);
      --card-bg: rgba(255, 255, 255, 0.92);
      --card-shadow: 0 20px 40px -15px rgba(6, 78, 59, 0.12), 0 0 0 1px rgba(6, 78, 59, 0.05);
    }

    [data-theme="dark"] {
      --surface-light: #0f172a;
      --bg-light: #020617;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --border-color: rgba(51, 65, 85, 0.6);
      --card-bg: rgba(15, 23, 42, 0.88);
      --card-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.08);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    body {
      background: var(--bg-light);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      position: relative;
      overflow-x: hidden;
      transition: background-color 0.3s ease, color 0.3s ease;
    }

    /* Ambient background glowing orbs */
    .ambient-bg {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      overflow: hidden;
    }
    .ambient-orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(90px);
      opacity: 0.15;
    }
    .ambient-orb-1 {
      width: 480px;
      height: 480px;
      background: var(--primary-600);
      top: -120px;
      left: -100px;
    }
    .ambient-orb-2 {
      width: 520px;
      height: 520px;
      background: var(--gold-500);
      bottom: -150px;
      right: -120px;
    }

    /* Top Navigation bar */
    .login-topbar {
      position: relative;
      z-index: 10;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.25rem 2rem;
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-color);
    }
    .brand-link {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
      color: var(--text-main);
      font-weight: 700;
      font-size: 1.15rem;
    }
    .brand-logo-img {
      width: 38px;
      height: 38px;
      object-fit: contain;
      border-radius: 8px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.08);
    }

    .top-actions {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }
    .wita-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(6, 78, 59, 0.08);
      color: var(--primary-700);
      padding: 0.4rem 0.85rem;
      border-radius: 9999px;
      font-size: 0.82rem;
      font-weight: 600;
      font-family: 'JetBrains Mono', monospace;
    }
    [data-theme="dark"] .wita-badge {
      background: rgba(16, 185, 129, 0.12);
      color: #34d399;
    }
    .pulse-dot {
      width: 8px;
      height: 8px;
      background: #10b981;
      border-radius: 50%;
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
      animation: pulse 2s infinite;
    }
    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
      70% { box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
      100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }

    .btn-theme-toggle {
      background: transparent;
      border: 1px solid var(--border-color);
      color: var(--text-main);
      width: 38px;
      height: 38px;
      border-radius: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .btn-theme-toggle:hover {
      background: rgba(6, 78, 59, 0.08);
      border-color: var(--primary-600);
    }

    /* Main Container */
    .login-wrapper {
      position: relative;
      z-index: 10;
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2.5rem 1rem;
    }
    .login-card {
      width: 100%;
      max-width: 440px;
      background: var(--card-bg);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--border-color);
      border-radius: 24px;
      padding: 2.5rem 2.25rem;
      box-shadow: var(--card-shadow);
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    @media (max-width: 480px) {
      .login-card {
        padding: 2rem 1.5rem;
        border-radius: 20px;
      }
    }

    .login-header {
      text-align: center;
      margin-bottom: 2rem;
    }
    .shield-badge {
      width: 64px;
      height: 64px;
      background: linear-gradient(135deg, var(--primary-800) 0%, var(--primary-600) 100%);
      color: #ffffff;
      border-radius: 18px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.85rem;
      margin-bottom: 1.25rem;
      box-shadow: 0 10px 25px -5px rgba(5, 150, 105, 0.4);
    }
    .login-title {
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: var(--text-main);
      margin-bottom: 0.35rem;
    }
    .login-subtitle {
      font-size: 0.88rem;
      color: var(--text-muted);
      line-height: 1.4;
    }

    /* Form Inputs */
    .form-group-custom {
      margin-bottom: 1.25rem;
    }
    .form-label-custom {
      display: block;
      font-size: 0.85rem;
      font-weight: 600;
      margin-bottom: 0.45rem;
      color: var(--text-main);
    }
    .input-wrapper {
      position: relative;
    }
    .input-icon {
      position: absolute;
      left: 1rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      font-size: 1.1rem;
      pointer-events: none;
      transition: color 0.2s ease;
    }
    .form-control-custom {
      width: 100%;
      padding: 0.8rem 1rem 0.8rem 2.85rem;
      background: rgba(248, 250, 252, 0.8);
      border: 1.5px solid var(--border-color);
      border-radius: 14px;
      color: var(--text-main);
      font-size: 0.95rem;
      transition: all 0.2s ease;
      outline: none;
    }
    [data-theme="dark"] .form-control-custom {
      background: rgba(30, 41, 59, 0.7);
    }
    .form-control-custom:focus {
      background: var(--surface-light);
      border-color: var(--primary-600);
      box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.15);
    }
    .form-control-custom:focus + .input-icon {
      color: var(--primary-600);
    }
    .btn-toggle-pass {
      position: absolute;
      right: 0.85rem;
      top: 50%;
      transform: translateY(-50%);
      background: transparent;
      border: none;
      color: var(--text-muted);
      cursor: pointer;
      padding: 0.25rem;
      font-size: 1.15rem;
    }
    .btn-toggle-pass:hover {
      color: var(--text-main);
    }

    /* Submit Button */
    .btn-submit-login {
      width: 100%;
      padding: 0.9rem 1.5rem;
      background: linear-gradient(135deg, var(--primary-800) 0%, var(--primary-600) 100%);
      color: #ffffff;
      border: none;
      border-radius: 14px;
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: -0.01em;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      cursor: pointer;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 10px 20px -5px rgba(5, 150, 105, 0.35);
      margin-top: 0.75rem;
    }
    .btn-submit-login:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 14px 28px -6px rgba(5, 150, 105, 0.45);
      background: linear-gradient(135deg, var(--primary-900) 0%, var(--primary-700) 100%);
    }
    .btn-submit-login:active:not(:disabled) {
      transform: translateY(0);
    }
    .btn-submit-login:disabled {
      opacity: 0.65;
      cursor: not-allowed;
    }

    /* Footer links */
    .login-footer {
      margin-top: 1.75rem;
      text-align: center;
      padding-top: 1.25rem;
      border-top: 1px solid var(--border-color);
    }
    .back-home-link {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: 600;
      transition: color 0.2s ease;
    }
    .back-home-link:hover {
      color: var(--primary-600);
    }

    /* Toast Notification */
    .toast-container {
      position: fixed;
      top: 1.5rem;
      right: 1.5rem;
      z-index: 9999;
    }
    .custom-toast {
      background: var(--surface-light);
      border: 1px solid var(--border-color);
      box-shadow: 0 20px 40px rgba(0,0,0,0.15);
      border-radius: 14px;
      padding: 1rem 1.25rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      min-width: 320px;
      animation: slideInRight 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes slideInRight {
      from { transform: translateX(100%); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }
  </style>
</head>
<body>

  <!-- Ambient glowing backdrop -->
  <div class="ambient-bg">
    <div class="ambient-orb ambient-orb-1"></div>
    <div class="ambient-orb ambient-orb-2"></div>
  </div>

  <!-- Top bar -->
  <header class="login-topbar">
    <a href="/" class="brand-link">
      <img src="/dpmfkgumi.webp" alt="DPM KBMFKG UMI" class="brand-logo-img">
      <span>DPM KBMFKG UMI</span>
    </a>
    <div class="top-actions">
      <div class="wita-badge d-none d-sm-inline-flex">
        <span class="pulse-dot"></span>
        <span id="liveWitaClock">--:--:-- WITA</span>
      </div>
      <button class="btn-theme-toggle" id="themeToggleBtn" title="Ganti Tema">
        <i class="bi bi-moon-stars-fill" id="themeIcon"></i>
      </button>
    </div>
  </header>

  <!-- Login Card Container -->
  <main class="login-wrapper">
    <div class="login-card">
      <div class="login-header">
        <div class="shield-badge">
          <i class="bi bi-shield-lock-fill"></i>
        </div>
        <h1 class="login-title">Portal Anggota Dewan</h1>
        <p class="login-subtitle">Sistem Informasi Tata Kelola & Backoffice Parlemen Mahasiswa Fakultas Kedokteran Gigi UMI</p>
      </div>

      <form id="formLoginAdmin" onsubmit="handleAdminLogin(event)">
        <div class="form-group-custom">
          <label class="form-label-custom" for="loginUsername">Username atau NIM <span class="text-danger">*</span></label>
          <div class="input-wrapper">
            <input 
              type="text" 
              class="form-control-custom" 
              id="loginUsername" 
              name="username" 
              placeholder="Masukkan username atau NIM Anda..." 
              autocomplete="username" 
              required
            >
            <i class="bi bi-person-fill input-icon"></i>
          </div>
        </div>

        <div class="form-group-custom">
          <label class="form-label-custom" for="loginPassword">Kata Sandi <span class="text-danger">*</span></label>
          <div class="input-wrapper">
            <input 
              type="password" 
              class="form-control-custom" 
              id="loginPassword" 
              name="password" 
              placeholder="••••••••" 
              autocomplete="current-password" 
              required
            >
            <i class="bi bi-key-fill input-icon"></i>
            <button type="button" class="btn-toggle-pass" onclick="togglePasswordVisibility()" title="Lihat/Sembunyikan Sandi">
              <i class="bi bi-eye-slash-fill" id="eyeIcon"></i>
            </button>
          </div>
        </div>

        <button type="submit" class="btn-submit-login" id="btnLoginSubmit">
          <i class="bi bi-box-arrow-in-right"></i>
          <span>Masuk ke Backoffice</span>
        </button>
      </form>

      <div class="login-footer">
        <a href="/" class="back-home-link">
          <i class="bi bi-arrow-left"></i>
          <span>Kembali ke Portal Publik</span>
        </a>
      </div>
    </div>
  </main>

  <!-- Toast Notification Area -->
  <div class="toast-container" id="toastArea"></div>

  <script>
    // Theme Management
    const themeBtn = document.getElementById('themeToggleBtn');
    const themeIcon = document.getElementById('themeIcon');

    function applyTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      localStorage.setItem('dpm_theme', theme);
      if (theme === 'dark') {
        themeIcon.className = 'bi bi-sun-fill text-warning';
      } else {
        themeIcon.className = 'bi bi-moon-stars-fill';
      }
    }

    const savedTheme = localStorage.getItem('dpm_theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    applyTheme(savedTheme);

    themeBtn.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme') || 'light';
      applyTheme(current === 'dark' ? 'light' : 'dark');
    });

    // Live WITA Clock
    function updateClock() {
      const el = document.getElementById('liveWitaClock');
      if (!el) return;
      const now = new Date();
      el.textContent = now.toLocaleTimeString('id-ID', { hour12: false }) + ' WITA';
    }
    setInterval(updateClock, 1000);
    updateClock();

    // Toggle Password Visibility
    function togglePasswordVisibility() {
      const pass = document.getElementById('loginPassword');
      const icon = document.getElementById('eyeIcon');
      if (pass.type === 'password') {
        pass.type = 'text';
        icon.className = 'bi bi-eye-fill';
      } else {
        pass.type = 'password';
        icon.className = 'bi bi-eye-slash-fill';
      }
    }

    // Toast Notification Helper
    function showToast(message, isSuccess = true) {
      const area = document.getElementById('toastArea');
      const toast = document.createElement('div');
      toast.className = 'custom-toast';
      toast.innerHTML = `
        <div style="font-size: 1.4rem; color: ${isSuccess ? '#10b981' : '#ef4444'};">
          <i class="bi bi-${isSuccess ? 'check-circle-fill' : 'exclamation-triangle-fill'}"></i>
        </div>
        <div style="font-size: 0.9rem; font-weight: 500; color: var(--text-main);">${message}</div>
      `;
      area.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(-10px)';
        toast.style.transition = 'all 0.3s ease';
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    // Handle Admin Login Submission
    async function handleAdminLogin(event) {
      event.preventDefault();
      const btn = document.getElementById('btnLoginSubmit');
      const username = document.getElementById('loginUsername').value.trim();
      const password = document.getElementById('loginPassword').value.trim();

      if (!username || !password) {
        showToast('Username dan kata sandi wajib diisi.', false);
        return;
      }

      btn.disabled = true;
      btn.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span> Memverifikasi...`;

      try {
        const response = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password })
        });
        const res = await response.json();

        if (res && res.success && res.data) {
          showToast(res.message || 'Login berhasil! Mengalihkan ke backoffice...', true);
          localStorage.setItem('dpm_user', JSON.stringify(res.data));
          setTimeout(() => {
            window.location.href = '/admin';
          }, 800);
        } else {
          showToast(res?.message || 'Login gagal. Periksa username dan password.', false);
          btn.disabled = false;
          btn.innerHTML = `<i class="bi bi-box-arrow-in-right"></i> <span>Masuk ke Backoffice</span>`;
        }
      } catch (err) {
        console.error('Login error:', err);
        showToast('Terjadi gangguan jaringan ke server.', false);
        btn.disabled = false;
        btn.innerHTML = `<i class="bi bi-box-arrow-in-right"></i> <span>Masuk ke Backoffice</span>`;
      }
    }

    // Auto-redirect if already logged in
    document.addEventListener('DOMContentLoaded', () => {
      try {
        const session = JSON.parse(localStorage.getItem('dpm_user') || 'null');
        if (session && session.username && session.role) {
          // User already logged in, redirect directly to admin
          window.location.href = '/admin';
        }
      } catch (e) {}
    });
  </script>
</body>
</html>
