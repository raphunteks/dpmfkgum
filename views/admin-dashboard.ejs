<%- include('partials/header') %>

<div class="animate-fade-in pt-4 relative z-10">
    <!-- Header Admin -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-10 pb-6 border-b border-[var(--glass-border)] gap-6">
        <div class="flex items-center gap-4">
            <div class="w-16 h-16 rounded-2xl neu-inset flex items-center justify-center">
                <i class="ph ph-fingerprint text-4xl holographic-text"></i>
            </div>
            <div>
                <h2 class="text-3xl font-black text-[var(--text-main)]">System Command</h2>
                <p class="font-medium text-[var(--text-muted)] mt-1">Otoritas Super Admin <%= DB.organization ? DB.organization.name : 'DPM KBMFKG UMI' %></p>
            </div>
        </div>
        <div class="flex items-center gap-4 w-full md:w-auto">
            <div class="px-5 py-2.5 neu-inset rounded-xl text-sm font-bold text-[var(--brand-primary)] flex items-center gap-2 flex-1 md:flex-none justify-center">
                <i class="ph ph-shield-check animate-pulse"></i> Root Access
            </div>
            <a href="/admin/logout" class="px-5 py-2.5 rounded-xl text-sm font-bold bg-rose-500 text-white shadow-[0_5px_15px_rgba(225,29,72,0.4)] hover:bg-rose-600 transition-colors flex items-center gap-2 justify-center flex-1 md:flex-none">
                <i class="ph ph-power"></i> Log Out
            </a>
        </div>
    </div>

    <div class="flex flex-col lg:flex-row gap-10">
        <!-- Sidebar Navigation (Diubah Sesuai Gbr 1 Request) -->
        <div class="w-full lg:w-72 shrink-0 space-y-4 neu-flat p-4 h-fit">
            <h3 class="text-xs font-black uppercase tracking-widest text-[var(--text-muted)] pl-4 mb-4">Core Modules</h3>
            <a href="/admin" class="w-full flex items-center gap-4 px-5 py-4 rounded-xl transition-all font-bold bg-[var(--brand-primary)] text-white shadow-lg shadow-cyan-500/30">
                <i class="ph ph-squares-four text-xl"></i> Overview
            </a>
            <a href="/admin/tentang" class="w-full flex items-center gap-4 px-5 py-4 rounded-xl transition-all font-bold text-[var(--text-muted)] hover:text-[var(--text-main)] hover:neu-inset">
                <i class="ph ph-users text-xl"></i> Tentang
            </a>
            <a href="/admin/program-kerja" class="w-full flex items-center gap-4 px-5 py-4 rounded-xl transition-all font-bold text-[var(--text-muted)] hover:text-[var(--text-main)] hover:neu-inset">
                <i class="ph ph-briefcase text-xl"></i> Program Kerja
            </a>
            <a href="/admin/berita" class="w-full flex items-center gap-4 px-5 py-4 rounded-xl transition-all font-bold text-[var(--text-muted)] hover:text-[var(--text-main)] hover:neu-inset">
                <i class="ph ph-newspaper text-xl"></i> Berita
            </a>
            <a href="/admin/our-team" class="w-full flex items-center gap-4 px-5 py-4 rounded-xl transition-all font-bold text-[var(--text-muted)] hover:text-[var(--text-main)] hover:neu-inset">
                <i class="ph ph-star text-xl"></i> Our Team
            </a>
        </div>

        <!-- Main Content Area -->
        <div class="flex-1 space-y-8">
            
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                <div class="neu-flat p-6 relative overflow-hidden group">
                    <div class="absolute -right-4 -top-4 text-[var(--bg-base)] opacity-50 group-hover:scale-150 transition-transform duration-500"><i class="ph-fill ph-users text-8xl"></i></div>
                    <p class="text-[var(--text-muted)] text-xs font-black uppercase tracking-widest mb-2 relative z-10">Total Pengurus</p>
                    <h4 class="text-4xl font-black text-[var(--text-main)] relative z-10"><%= DB.team ? DB.team.length + 141 : 142 %></h4>
                </div>
                
                <div class="neu-flat p-6 relative overflow-hidden group">
                    <div class="absolute -right-4 -top-4 text-[var(--brand-primary)] opacity-10 group-hover:scale-150 transition-transform duration-500"><i class="ph-fill ph-briefcase text-8xl"></i></div>
                    <p class="text-[var(--text-muted)] text-xs font-black uppercase tracking-widest mb-2 relative z-10">Proker Berjalan</p>
                    <h4 class="text-4xl font-black text-[var(--brand-primary)] relative z-10"><%= DB.programs ? DB.programs.filter(p => p.status === 'ONGOING').length : 0 %></h4>
                </div>
                
                <div class="neu-flat p-6 relative overflow-hidden group">
                    <div class="absolute -right-4 -top-4 text-emerald-500 opacity-10 group-hover:scale-150 transition-transform duration-500"><i class="ph-fill ph-newspaper text-8xl"></i></div>
                    <p class="text-[var(--text-muted)] text-xs font-black uppercase tracking-widest mb-2 relative z-10">Berita Publik</p>
                    <h4 class="text-4xl font-black text-emerald-500 relative z-10"><%= DB.news ? DB.news.filter(n => n.status === 'PUBLISHED').length : 0 %></h4>
                </div>
                
                <div class="neu-inset p-6 relative flex flex-col justify-center border border-[var(--glass-border)]">
                    <div class="absolute top-4 right-4 flex h-4 w-4">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-4 w-4 bg-cyan-500"></span>
                    </div>
                    <p class="text-[var(--text-muted)] text-xs font-black uppercase tracking-widest mb-1">Database Status</p>
                    <h4 class="text-xl font-black text-[var(--brand-primary)] animate-pulse-holo">SYNCED REALTIME</h4>
                </div>
            </div>

            <!-- Audit Log (Glassmorphism Table) -->
            <div class="glass-card p-8">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4">
                    <h3 class="font-black text-2xl text-[var(--text-main)] flex items-center gap-3">
                        <i class="ph ph-terminal-window text-[var(--brand-primary)]"></i> Sistem Log Audit
                    </h3>
                    <button class="px-5 py-2 rounded-xl text-sm font-bold neu-flat text-[var(--text-main)] hover:text-[var(--brand-primary)] transition-all flex items-center gap-2">
                        <i class="ph ph-export"></i> Unduh CSV
                    </button>
                </div>
                
                <div class="overflow-hidden rounded-2xl neu-inset">
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm text-left">
                            <thead class="text-xs font-black uppercase tracking-widest text-[var(--text-muted)] bg-[var(--bg-base)] border-b border-[var(--glass-border)]">
                                <tr>
                                    <th class="px-6 py-5">Waktu</th>
                                    <th class="px-6 py-5">Aktor</th>
                                    <th class="px-6 py-5">Aksi</th>
                                    <th class="px-6 py-5">Entitas Detail</th>
                                </tr>
                            </thead>
                            <tbody class="text-[var(--text-main)] font-medium">
                                <tr class="border-b border-[var(--glass-border)] hover:bg-[var(--glass-bg)] transition-colors">
                                    <td class="px-6 py-5 text-[var(--text-muted)]">Baru saja</td>
                                    <td class="px-6 py-5 font-bold">Super Admin</td>
                                    <td class="px-6 py-5"><span class="px-3 py-1.5 bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 rounded-lg text-xs font-black tracking-wide border border-emerald-500/30">UPDATE</span></td>
                                    <td class="px-6 py-5">Sinkronisasi Data MongoDB Berhasil</td>
                                </tr>
                                <tr class="hover:bg-[var(--glass-bg)] transition-colors">
                                    <td class="px-6 py-5 text-[var(--text-muted)]">1 Jam lalu</td>
                                    <td class="px-6 py-5 font-bold">Super Admin</td>
                                    <td class="px-6 py-5"><span class="px-3 py-1.5 bg-blue-500/20 text-blue-600 dark:text-blue-400 rounded-lg text-xs font-black tracking-wide border border-blue-500/30">LOGIN</span></td>
                                    <td class="px-6 py-5">Otentikasi Dashboard Area</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            
        </div>
    </div>
</div>

<%- include('partials/footer') %>
