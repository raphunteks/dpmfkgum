    // Upload File Helper Functions
    async function handleUploadPdf(inputEl, targetInputId, statusElId) {
      const file = inputEl.files && inputEl.files[0];
      if (!file) return;
      if (!file.name.toLowerCase().endsWith('.pdf')) {
        showToast('Hanya dokumen .pdf yang diperbolehkan!', false);
        inputEl.value = '';
        return;
      }
      const statusEl = document.getElementById(statusElId);
      if (statusEl) {
        statusEl.innerHTML = '<span class="text-primary"><i class="spinner-border spinner-border-sm me-1"></i> Mengunggah file PDF native...</span>';
      }
      const formData = new FormData();
      formData.append('file', file);

      try {
        const response = await fetch('/api/upload/pdf', {
          method: 'POST',
          body: formData
        });
        const res = await response.json();
        if (res && res.success && res.data) {
          document.getElementById(targetInputId).value = res.data.fileUrl;
          if (statusEl) {
            statusEl.innerHTML = `<span class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i> Terunggah: ${res.data.fileName} (SEO Native)</span>`;
          }
          showToast('Dokumen PDF berhasil diunggah secara native!');
        } else {
          if (statusEl) {
            statusEl.innerHTML = `<span class="text-danger"><i class="bi bi-x-circle me-1"></i> ${res?.message || 'Gagal unggah PDF.'}</span>`;
          }
          showToast(res?.message || 'Gagal mengunggah PDF.', false);
        }
      } catch (err) {
        if (statusEl) statusEl.innerHTML = '<span class="text-danger">Kesalahan jaringan saat unggah file.</span>';
        showToast('Kesalahan jaringan saat unggah file.', false);
      }
    }

    async function handleUploadImg(inputEl, targetInputId, statusElId, previewWrapId) {
      const file = inputEl.files && inputEl.files[0];
      if (!file) return;
      if (!file.type.startsWith('image/')) {
        showToast('Hanya file gambar (JPG, PNG, WEBP) yang diperbolehkan!', false);
        inputEl.value = '';
        return;
      }
      const statusEl = document.getElementById(statusElId);
      if (statusEl) {
        statusEl.innerHTML = '<span class="text-primary"><i class="spinner-border spinner-border-sm me-1"></i> Mengunggah banner gambar...</span>';
      }
      const formData = new FormData();
      formData.append('file', file);

      try {
