    function renderCharts(chartData) {
      if (!chartData) return;

      const ctxAsp = document.getElementById('aspirasiChart');
      if (ctxAsp) {
        if (chartAspirasi) chartAspirasi.destroy();
        chartAspirasi = new Chart(ctxAsp, {
          type: 'doughnut',
          data: {
            labels: chartData.aspirasiKategori?.labels || [],
            datasets: [{
              data: chartData.aspirasiKategori?.values || [],
              backgroundColor: ['#059669', '#0284C7', '#D97706', '#E11D48']
            }]
          },
          options: { responsive: true, maintainAspectRatio: false }
        });
      }

      const ctxAng = document.getElementById('anggaranChart');
      if (ctxAng) {
        if (chartAnggaran) chartAnggaran.destroy();
        chartAnggaran = new Chart(ctxAng, {
          type: 'bar',
          data: {
            labels: chartData.anggaranOrmawa?.labels || [],
            datasets: [{
              label: 'Anggaran Disetujui (Rp)',
              data: chartData.anggaranOrmawa?.values || [],
              backgroundColor: '#0284C7',
              borderRadius: 6
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: { y: { ticks: { callback: v => 'Rp ' + (v/1000000) + 'jt' } } }
          }
        });
      }
    }

