<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Backoffice Parlemen - DPM KBMFKG UMI</title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" type="image/webp" href="/dpmfkgumi.webp">
  <link rel="apple-touch-icon" href="/dpmfkgumi.webp">

  <!-- Fonts & Core Dependencies -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>

  <style>
    :root {
      --primary-emerald: #064E3B;
      --primary-emerald-dark: #022C22;
      --primary-emerald-light: #059669;
      --secondary-cyan: #0284C7;
      --secondary-cyan-light: #38BDF8;
      --accent-gold: #D97706;
      --accent-gold-light: #FBBF24;
      --bg-page: #F8FAFC;
      --bg-card: #FFFFFF;
      --bg-card-hover: #F1F5F9;
      --bg-surface-glass: rgba(255, 255, 255, 0.85);
      --text-primary: #0F172A;
      --text-secondary: #475569;
      --text-muted: #94A3B8;
      --border-subtle: #E2E8F0;
      --border-medium: #CBD5E1;
      --border-focus: #0284C7;
      --sidebar-bg: #064E3B;
      --sidebar-text: #E2E8F0;
      --font-main: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
      --radius-full: 9999px;
      --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
      --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
      --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    }

    [data-theme="dark"] {
      --bg-page: #041728;
      --bg-card: #082845;
      --bg-card-hover: #0D3559;
      --bg-surface-glass: rgba(8, 40, 69, 0.88);
      --text-primary: #F0F9FF;
      --text-secondary: #BAE6FD;
      --text-muted: #7DD3FC;
      --border-subtle: #0C4A6E;
      --border-medium: #0369A1;
      --border-focus: #38BDF8;
      --sidebar-bg: #031D33;
      --sidebar-text: #E0F2FE;
      --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.5);
      --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.5);
      --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.6);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: var(--font-main); }
    body { background: var(--bg-page); color: var(--text-primary); min-height: 100vh; overflow-x: hidden; }

    /* Layout */
    .backoffice-wrapper { display: flex; min-height: 100vh; }
    .backoffice-sidebar {
      width: 270px;
      background: var(--sidebar-bg);
      color: var(--sidebar-text);
      position: fixed;
      top: 0; bottom: 0; left: 0;
      z-index: 1040;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      box-shadow: var(--shadow-lg);
      border-right: 1px solid rgba(255, 255, 255, 0.05);
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .sidebar-header-box { padding: 1.5rem 1.25rem 1rem 1.25rem; border-bottom: 1px solid rgba(255, 255, 255, 0.07); }
    .sidebar-brand-name { color: #FFFFFF; font-weight: 800; font-size: 1.05rem; margin: 0; line-height: 1.2; }
    .sidebar-brand-sub { color: var(--accent-gold-light); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; }
    .sidebar-user-pill {
      background: rgba(255, 255, 255, 0.06);
      border-radius: var(--radius-md);
      padding: 0.75rem;
      margin-top: 1rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .sidebar-user-avatar {
      width: 36px; height: 36px;
      border-radius: var(--radius-full);
      background: linear-gradient(135deg, var(--secondary-cyan), var(--primary-emerald-light));
      color: #FFFFFF;
      display: flex; align-items: center; justify-content: center;
      font-weight: 700; font-size: 0.95rem;
    }
    .sidebar-menu-scroll { flex: 1; padding: 1rem 0.75rem; }
    .sidebar-group-title {
      font-size: 0.68rem; font-weight: 800; text-transform: uppercase;
      letter-spacing: 0.08em; color: rgba(255, 255, 255, 0.45);
      padding: 0.75rem 0.75rem 0.35rem 0.75rem;
    }
    .sidebar-nav-item {
      display: flex; align-items: center; gap: 0.85rem;
      padding: 0.65rem 0.85rem;
      color: var(--sidebar-text);
      border-radius: var(--radius-sm);
      text-decoration: none;
      font-size: 0.88rem; font-weight: 600;
      cursor: pointer; margin-bottom: 2px;
      transition: all 0.2s ease;
    }
    .sidebar-nav-item i { font-size: 1.15rem; width: 20px; text-align: center; }
    .sidebar-nav-item:hover { color: #FFFFFF; background: rgba(255, 255, 255, 0.08); }
    .sidebar-nav-item.active {
      color: #FFFFFF;
      background: linear-gradient(90deg, rgba(2, 132, 199, 0.35), rgba(6, 78, 59, 0.45));
      border-left: 3px solid var(--secondary-cyan-light);
    }
    .sidebar-footer-box { padding: 1rem; border-top: 1px solid rgba(255, 255, 255, 0.07); }

    .backoffice-main {
      margin-left: 270px;
      flex: 1;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      transition: margin-left 0.3s ease;
    }
    .backoffice-topbar {
      background: var(--bg-surface-glass);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-subtle);
      padding: 0.75rem 1.75rem;
      display: flex; align-items: center; justify-content: space-between;
      position: sticky; top: 0; z-index: 1030;
    }
    .wita-clock-badge {
      font-family: var(--font-mono);
      font-size: 0.85rem; font-weight: 600;
      padding: 0.35rem 0.75rem;
      border-radius: var(--radius-sm);
      background: rgba(6, 78, 59, 0.08);
      color: var(--primary-emerald);
      border: 1px solid rgba(6, 78, 59, 0.2);
    }
    [data-theme="dark"] .wita-clock-badge {
      background: rgba(56, 189, 248, 0.1);
      color: var(--secondary-cyan-light);
      border-color: rgba(56, 189, 248, 0.2);
    }
    .backoffice-body { padding: 1.75rem; flex: 1; }

    /* Responsive Sidebar */
    .sidebar-backdrop {
      position: fixed; inset: 0;
      background: rgba(0, 0, 0, 0.5);
      backdrop-filter: blur(4px);
      z-index: 1035;
      display: none;
    }
    @media (max-width: 991px) {
      .backoffice-sidebar { transform: translateX(-100%); }
      .backoffice-sidebar.show { transform: translateX(0); }
      .backoffice-main { margin-left: 0; }
      .sidebar-backdrop.show { display: block; }
    }

    /* Cards & Widgets */
    .app-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 1.5rem;
      box-shadow: var(--shadow-sm);
    }
    .stat-widget {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 1.25rem;
      display: flex; align-items: center; gap: 1rem;
      box-shadow: var(--shadow-sm);
    }
    .stat-icon-wrap {
      width: 48px; height: 48px;
      border-radius: var(--radius-md);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.4rem;
    }
    .stat-icon-cyan { background: rgba(2, 132, 199, 0.1); color: var(--secondary-cyan); }
    .stat-icon-emerald { background: rgba(6, 78, 59, 0.1); color: var(--primary-emerald); }
    .stat-icon-gold { background: rgba(217, 119, 6, 0.1); color: var(--accent-gold); }
    .stat-icon-red { background: rgba(225, 29, 72, 0.1); color: #e11d48; }
    .stat-val { font-size: 1.5rem; font-weight: 800; line-height: 1.1; }
    .stat-title { font-size: 0.8rem; color: var(--text-secondary); font-weight: 600; text-transform: uppercase; }

    /* Tables */
    .table-custom-wrapper {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      overflow-x: auto;
      box-shadow: var(--shadow-sm);
    }
    .table-custom { width: 100%; border-collapse: separate; border-spacing: 0; margin-bottom: 0; }
    .table-custom thead th {
      background: var(--bg-page);
      color: var(--text-secondary);
      font-size: 0.78rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.05em;
      padding: 0.85rem 1rem;
      border-bottom: 1px solid var(--border-medium);
      white-space: nowrap; position: sticky; top: 0; z-index: 10;
    }
    .table-custom tbody tr:hover { background-color: var(--bg-card-hover); }
    .table-custom tbody td { padding: 0.85rem 1rem; border-bottom: 1px solid var(--border-subtle); font-size: 0.88rem; vertical-align: middle; }

    /* Badges & Buttons */
    .badge-status {
      display: inline-flex; align-items: center; gap: 0.35rem;
      padding: 0.3rem 0.65rem; border-radius: var(--radius-full);
      font-size: 0.75rem; font-weight: 700;
    }
    .badge-status.success { background: rgba(16, 185, 129, 0.12); color: #10b981; }
    .badge-status.warning { background: rgba(245, 158, 11, 0.12); color: #f59e0b; }
    .badge-status.process { background: rgba(2, 132, 199, 0.12); color: #0284c7; }
    .badge-status.danger { background: rgba(239, 68, 68, 0.12); color: #ef4444; }

    .btn-emerald {
      background: linear-gradient(135deg, var(--primary-emerald), var(--primary-emerald-light));
      color: #FFFFFF; font-weight: 600; border: none;
      border-radius: var(--radius-sm); padding: 0.5rem 1rem;
      transition: all 0.2s ease;
    }
    .btn-emerald:hover { background: var(--primary-emerald-dark); color: #FFFFFF; transform: translateY(-1px); }
    .btn-outline-custom {
      border: 1px solid var(--border-medium); color: var(--text-primary);
      background: transparent; border-radius: var(--radius-sm);
      padding: 0.4rem 0.8rem; font-weight: 600; font-size: 0.85rem;
    }
    .btn-outline-custom:hover { background: var(--bg-card-hover); }

    /* Form Controls */
    .form-label-custom { font-size: 0.84rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.35rem; display: block; }
    .form-control-custom, .form-select-custom {
      background: var(--bg-card); border: 1.5px solid var(--border-medium);
      border-radius: var(--radius-md); padding: 0.6rem 0.9rem;
      color: var(--text-primary); font-size: 0.9rem; width: 100%; outline: none;
    }
    .form-control-custom:focus, .form-select-custom:focus {
      border-color: var(--border-focus); box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
    }

    /* Modals */
    .modal-content-custom {
      background: var(--bg-card); border: 1px solid var(--border-medium);
      border-radius: var(--radius-lg); box-shadow: var(--shadow-lg);
    }
    .modal-header-custom {
      border-bottom: 1px solid var(--border-subtle); padding: 1.25rem 1.5rem;
    }

    /* Print Styles */
    @media print {
      body * { visibility: hidden; }
      #printableOfficialContent, #printableOfficialContent * { visibility: visible; }
      #printableOfficialContent { position: absolute; left: 0; top: 0; width: 100%; }
    }
  </style>
</head>
<body>

  <!-- Loading Overlay -->
  <div id="globalLoadingOverlay" style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); backdrop-filter: blur(4px); z-index: 9999; display: none; align-items: center; justify-content: center; flex-direction: column;">
    <div class="spinner-border text-light mb-2" role="status"></div>
    <div class="text-white fw-bold small" id="globalLoadingText">Memproses data...</div>
  </div>

  <div class="backoffice-wrapper">
    <!-- Sidebar -->
    <aside class="backoffice-sidebar" id="appSidebar">
      <div class="sidebar-header-box">
        <div class="d-flex align-items-center gap-2">
          <img src="/dpmfkgumi.webp" alt="DPM Logo" style="width: 36px; height: 36px; object-fit: contain; border-radius: 8px;">
          <div>
            <h6 class="sidebar-brand-name">PARLEMEN DPM</h6>
            <div class="sidebar-brand-sub">FKG UMI MAKASSAR</div>
          </div>
        </div>

        <div class="sidebar-user-pill">
          <div class="sidebar-user-avatar" id="sidebarAvatar">A</div>
          <div class="overflow-hidden">
            <div class="fw-bold text-white small text-truncate" id="sidebarUserName">Nama User</div>
            <div class="badge-status process p-1 py-0" style="font-size: 0.65rem;" id="sidebarUserRole">Role</div>
          </div>
        </div>
      </div>

      <div class="sidebar-menu-scroll">
        <div class="sidebar-group-title">Menu Utama</div>
        <a class="sidebar-nav-item active" onclick="switchBackofficeTab('dashboard')" data-tab="dashboard">
          <i class="bi bi-grid-1x2-fill"></i> <span>Dashboard Analytics</span>
        </a>

        <!-- Komisi I -->
        <div class="sidebar-group-title role-nav-komisi1">Komisi I: Legislasi</div>
        <a class="sidebar-nav-item role-nav-komisi1" onclick="switchBackofficeTab('jdihAdmin')" data-tab="jdihAdmin">
          <i class="bi bi-book-half"></i> <span>Bank Produk Hukum</span>
        </a>

        <!-- Komisi II -->
        <div class="sidebar-group-title role-nav-komisi2">Komisi II: Pengawasan</div>
        <a class="sidebar-nav-item role-nav-komisi2" onclick="switchBackofficeTab('prokerAdmin')" data-tab="prokerAdmin">
          <i class="bi bi-calendar2-range-fill"></i> <span>Monitoring Proker</span>
        </a>
        <a class="sidebar-nav-item role-nav-komisi2" onclick="switchBackofficeTab('inspeksiAdmin')" data-tab="inspeksiAdmin">
          <i class="bi bi-clipboard2-check-fill"></i> <span>Inspeksi Lapangan</span>
        </a>

        <!-- Komisi III -->
        <div class="sidebar-group-title role-nav-komisi3">Komisi III: Advokasi</div>
        <a class="sidebar-nav-item role-nav-komisi3" onclick="switchBackofficeTab('aspirasiAdmin')" data-tab="aspirasiAdmin">
          <i class="bi bi-inbox-fill"></i> <span>Meja E-Aspirasi</span>
        </a>

        <!-- Badan Anggaran -->
        <div class="sidebar-group-title role-nav-banggar">Badan Anggaran</div>
        <a class="sidebar-nav-item role-nav-banggar" onclick="switchBackofficeTab('proposalAdmin')" data-tab="proposalAdmin">
          <i class="bi bi-file-earmark-medical-fill"></i> <span>Proposal Kegiatan</span>
        </a>
        <a class="sidebar-nav-item role-nav-banggar" onclick="switchBackofficeTab('lpjAdmin')" data-tab="lpjAdmin">
          <i class="bi bi-receipt-cutoff"></i> <span>Audit LPJ Keuangan</span>
        </a>

        <!-- Ormawa -->
        <div class="sidebar-group-title role-nav-ormawa">Portal Ormawa</div>
        <a class="sidebar-nav-item role-nav-ormawa" onclick="switchBackofficeTab('submitProposalTab')" data-tab="submitProposalTab">
          <i class="bi bi-cloud-arrow-up-fill"></i> <span>Ajukan Proposal (H-14)</span>
        </a>
        <a class="sidebar-nav-item role-nav-ormawa" onclick="switchBackofficeTab('submitLpjTab')" data-tab="submitLpjTab">
          <i class="bi bi-folder-check"></i> <span>Unggah LPJ (H+14)</span>
        </a>

        <!-- Publikasi -->
        <div class="sidebar-group-title role-nav-media">Publikasi</div>
        <a class="sidebar-nav-item role-nav-media" onclick="switchBackofficeTab('beritaAdmin')" data-tab="beritaAdmin">
          <i class="bi bi-newspaper"></i> <span>Berita & Siaran Pers</span>
        </a>

        <!-- Sistem / SuperAdmin -->
        <div class="sidebar-group-title role-nav-admin">Sistem & Master</div>
        <a class="sidebar-nav-item role-nav-admin" onclick="switchBackofficeTab('userAdmin')" data-tab="userAdmin">
          <i class="bi bi-people-fill"></i> <span>Manajemen Pengguna</span>
        </a>
        <a class="sidebar-nav-item role-nav-admin" onclick="switchBackofficeTab('configAdmin')" data-tab="configAdmin">
          <i class="bi bi-gear-wide-connected"></i> <span>Profil Organisasi</span>
        </a>
        <a class="sidebar-nav-item role-nav-admin" onclick="switchBackofficeTab('logsAdmin')" data-tab="logsAdmin">
          <i class="bi bi-shield-lock-fill"></i> <span>System Audit Logs</span>
        </a>
      </div>

      <div class="sidebar-footer-box">
        <button class="btn btn-outline-danger w-100 btn-sm d-flex align-items-center justify-content-center gap-2" onclick="logoutSession()">
          <i class="bi bi-box-arrow-left"></i> Keluar Sistem
        </button>
      </div>
    </aside>

    <div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleSidebarMobile()"></div>

    <!-- Main Workspace -->
    <main class="backoffice-main">
      <header class="backoffice-topbar">
        <div class="d-flex align-items-center gap-3">
          <button class="btn btn-sm btn-outline-custom d-lg-none" onclick="toggleSidebarMobile()">
            <i class="bi bi-list fs-5"></i>
          </button>
          <h5 class="fw-bold mb-0" id="currentTabTitle">Dashboard Analytics</h5>
        </div>

        <div class="d-flex align-items-center gap-2">
          <div class="wita-clock-badge d-none d-sm-block" id="witaLiveClockBackoffice">
            <i class="bi bi-clock me-1"></i> --:--:-- WITA
          </div>
          <button class="btn btn-sm btn-outline-custom" onclick="toggleTheme()" title="Ganti Tema">
            <i class="bi bi-moon-stars" id="themeIconBackoffice"></i>
          </button>
          <a href="/" class="btn btn-sm btn-outline-custom" title="Ke Web Publik">
            <i class="bi bi-globe me-1"></i> Web Publik
          </a>
        </div>
      </header>

      <div class="backoffice-body">
        
        <!-- TAB 1: DASHBOARD -->
        <div id="tab-dashboard" class="backoffice-tab-pane">
          <div class="app-card mb-4 p-4 text-white" style="background: linear-gradient(135deg, var(--primary-emerald), var(--secondary-cyan));">
            <div class="row align-items-center">
              <div class="col-md-8">
                <h4 class="fw-bold mb-1" id="dashGreetingText">Selamat Datang di Portal Parlemen DPM KBMFKG UMI</h4>
                <p class="mb-0 text-white-50">Sistem informasi terpadu legislasi, evaluasi kinerja ormawa, transparansi anggaran, dan meja advokasi aspirasi mahasiswa.</p>
              </div>
              <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <button class="btn btn-light btn-sm fw-bold me-2" onclick="refreshDashboard()"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
                <button class="btn btn-warning btn-sm fw-bold" onclick="printOfficialSummary()"><i class="bi bi-printer"></i> Cetak Rekap</button>
              </div>
            </div>
          </div>

          <div class="row g-3 mb-4">
            <div class="col-sm-6 col-xl-3">
              <div class="stat-widget">
                <div class="stat-icon-wrap stat-icon-cyan"><i class="bi bi-inbox"></i></div>
                <div>
                  <div class="stat-val font-mono" id="dashKpiAspirasi">0</div>
                  <div class="stat-title">Aspirasi Masuk</div>
                  <small class="text-success fw-bold" id="dashKpiAspirasiSub">0 Selesai</small>
                </div>
              </div>
            </div>
            <div class="col-sm-6 col-xl-3">
              <div class="stat-widget">
                <div class="stat-icon-wrap stat-icon-emerald"><i class="bi bi-clipboard-data"></i></div>
                <div>
                  <div class="stat-val font-mono" id="dashKpiProker">0%</div>
                  <div class="stat-title">Realisasi Proker</div>
                  <small class="text-primary fw-bold" id="dashKpiProkerSub">0 Terlaksana</small>
                </div>
              </div>
            </div>
            <div class="col-sm-6 col-xl-3">
              <div class="stat-widget">
                <div class="stat-icon-wrap stat-icon-gold"><i class="bi bi-book"></i></div>
                <div>
                  <div class="stat-val font-mono" id="dashKpiJdih">0</div>
                  <div class="stat-title">Produk Hukum</div>
                  <small class="text-muted" id="dashKpiJdihSub">0 Unduhan</small>
                </div>
              </div>
            </div>
            <div class="col-sm-6 col-xl-3">
              <div class="stat-widget">
                <div class="stat-icon-wrap stat-icon-red"><i class="bi bi-wallet2"></i></div>
                <div>
                  <div class="stat-val font-mono" id="dashKpiDana">Rp 0</div>
                  <div class="stat-title">Anggaran Disetujui</div>
                  <small class="text-danger fw-bold" id="dashKpiDanaSub">0 LPJ Lolos</small>
                </div>
              </div>
            </div>
          </div>

          <!-- Charts -->
          <div class="row g-4 mb-4">
            <div class="col-lg-6">
              <div class="app-card h-100">
                <h6 class="fw-bold mb-3"><i class="bi bi-pie-chart-fill text-success me-2"></i>Distribusi Aspirasi Per Kategori</h6>
                <div style="height: 260px; position: relative;">
                  <canvas id="aspirasiChart"></canvas>
                </div>
              </div>
            </div>
            <div class="col-lg-6">
              <div class="app-card h-100">
                <h6 class="fw-bold mb-3"><i class="bi bi-bar-chart-line-fill text-primary me-2"></i>Realisasi Anggaran Per Ormawa (Rp)</h6>
                <div style="height: 260px; position: relative;">
                  <canvas id="anggaranChart"></canvas>
                </div>
              </div>
            </div>
          </div>

          <!-- Recent Table -->
          <div class="app-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h6 class="fw-bold mb-0">Tiket Aspirasi Terbaru Membutuhkan Tindak Lanjut</h6>
              <button class="btn btn-sm btn-outline-custom" onclick="switchBackofficeTab('aspirasiAdmin')">Lihat Semua</button>
            </div>
            <div class="table-custom-wrapper">
              <table class="table-custom">
