        if (tb && d.recentAspirasi) {
          tb.innerHTML = d.recentAspirasi.map(a => `
            <tr>
              <td class="font-mono fw-bold">${a.kode_tiket}</td>
              <td><b>${a.nama_mahasiswa}</b></td>
