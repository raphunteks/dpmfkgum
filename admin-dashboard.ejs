    function autoGenerateBeritaSlug(title) {
      const slugInput = document.getElementById('beritaCrudSlug');
      if (!slugInput) return;
      const id = document.getElementById('beritaCrudId').value;
      if (!id || !slugInput.dataset.manualEdited) {
        slugInput.value = title
          .toLowerCase()
          .replace(/[^\w\s-]/g, '')
          .trim()
          .replace(/[\s_-]+/g, '-')
          .replace(/^-+|-+$/g, '');
      }
    }

