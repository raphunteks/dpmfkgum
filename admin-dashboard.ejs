        document.getElementById('dashKpiAspirasi').textContent = d.kpi?.totalAspirasi || 0;
        document.getElementById('dashKpiAspirasiSub').textContent = `${d.kpi?.aspirasiSelesai || 0} Terselesaikan`;
        document.getElementById('dashKpiProker').textContent = `${d.kpi?.prokerCapaianPersen || 0}%`;
        document.getElementById('dashKpiProkerSub').textContent = `${d.kpi?.prokerTerlaksana || 0} Terlaksana`;
        document.getElementById('dashKpiJdih').textContent = d.kpi?.totalJdih || 0;
        document.getElementById('dashKpiJdihSub').textContent = `${d.kpi?.totalUnduhan || 0} Total Unduhan`;
        document.getElementById('dashKpiDana').textContent = `Rp ${Number(d.kpi?.danaDisetujui || 0).toLocaleString('id-ID')}`;
        document.getElementById('dashKpiDanaSub').textContent = `${d.kpi?.lpjSelesai || 0} LPJ Lolos`;

