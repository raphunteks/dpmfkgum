    function switchBackofficeTab(tabName) {
      document.querySelectorAll('.backoffice-tab-pane').forEach(el => el.style.display = 'none');
      document.querySelectorAll('.sidebar-nav-item').forEach(el => el.classList.remove('active'));

      const cleanTab = tabName.replace('tab-', '');
      const targetPane = document.getElementById('tab-' + cleanTab);
      if (targetPane) targetPane.style.display = 'block';

      const navEl = document.querySelector(`.sidebar-nav-item[data-tab="${cleanTab}"]`);
      if (navEl) navEl.classList.add('active');

      const titleEl = document.getElementById('currentTabTitle');
      if (titleEl && TAB_TITLES[cleanTab]) titleEl.textContent = TAB_TITLES[cleanTab];

      // Close mobile sidebar on select
      const sb = document.getElementById('appSidebar');
      const bd = document.getElementById('sidebarBackdrop');
      if (sb) sb.classList.remove('show');
      if (bd) bd.classList.remove('show');

      // Auto trigger loaders
      if (cleanTab === 'dashboard') refreshDashboard();
      if (cleanTab === 'jdihAdmin') loadAllJdihAdmin();
      if (cleanTab === 'prokerAdmin') loadAllProkerAdmin();
      if (cleanTab === 'inspeksiAdmin') loadAllInspeksiAdmin();
      if (cleanTab === 'aspirasiAdmin') loadAllAspirasiAdmin();
      if (cleanTab === 'proposalAdmin') loadAllProposalAdmin();
      if (cleanTab === 'lpjAdmin') loadAllLpjAdmin();
      if (cleanTab === 'submitLpjTab') populateOrmawaProposalOptions();
      if (cleanTab === 'beritaAdmin') loadAllBeritaAdmin();
      if (cleanTab === 'userAdmin') loadAllUsersAdmin();
      if (cleanTab === 'configAdmin') loadConfigAdmin();
      if (cleanTab === 'logsAdmin') loadAllLogsAdmin();
    }

