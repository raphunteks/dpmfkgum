<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- ════════════════════════════════════════════════════════════════
       FULL DYNAMIC SERVER-SIDE RENDERING (SSR) SEO GOLD STANDARD GSC
       ════════════════════════════════════════════════════════════════ -->
  <title><%= (typeof seo !== 'undefined' && seo && seo.title) ? seo.title : 'Portal Resmi DPM KBMFKG UMI - Parlemen Mahasiswa Berintegritas & Transparan' %></title>
  <meta name="description" content="<%= (typeof seo !== 'undefined' && seo && seo.description) ? seo.description : 'Sistem Informasi Terpadu DPM KBMFKG UMI. Layanan E-Legislasi JDIH Ormawa, E-Aspirasi Advokasi Mahasiswa, dan Pengawasan Program Kerja FKG UMI.' %>">
  <meta name="keywords" content="<%= (typeof seo !== 'undefined' && seo && seo.keywords) ? seo.keywords : 'DPM FKG UMI, Parlemen Mahasiswa, Kedokteran Gigi UMI, Organisasi Kemahasiswaan Lingkup FKG UMI, JDIH FKG UMI, Aspirasi Mahasiswa, BEM FKG UMI, Advokasi Mahasiswa, Universitas Muslim Indonesia, Makassar' %>">
  <meta name="author" content="<%= (typeof seo !== 'undefined' && seo && seo.author) ? seo.author : 'DPM KBMFKG UMI' %>">
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
  <% if (typeof seo !== 'undefined' && seo && seo.canonicalUrl) { %>
  <link rel="canonical" href="<%= seo.canonicalUrl %>">
  <% } %>
  <meta name="theme-color" content="#064E3B">

  <!-- Favicon & Icon Web Resmi (dpmfkgumi.webp) -->
  <link rel="icon" type="image/webp" href="/dpmfkgumi.webp">
  <link rel="apple-touch-icon" href="/dpmfkgumi.webp">

  <!-- Open Graph Protocol (Facebook, LinkedIn, WhatsApp) -->
  <meta property="og:type" content="website">
  <meta property="og:locale" content="id_ID">
  <meta property="og:url" content="<%= (typeof seo !== 'undefined' && seo && seo.canonicalUrl) ? seo.canonicalUrl : '' %>">
  <meta property="og:title" content="<%= (typeof seo !== 'undefined' && seo && seo.title) ? seo.title : 'Portal Resmi DPM KBMFKG UMI' %>">
  <meta property="og:description" content="<%= (typeof seo !== 'undefined' && seo && seo.description) ? seo.description : 'Portal Resmi Parlemen Mahasiswa Fakultas Kedokteran Gigi Universitas Muslim Indonesia' %>">
  <meta property="og:image" content="<%= (typeof seo !== 'undefined' && seo && seo.ogImage) ? seo.ogImage : '/dpmfkgumi.webp' %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Logo Resmi DPM KBMFKG UMI">
  <meta property="og:site_name" content="DPM KBMFKG UMI">

  <!-- Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content="<%= (typeof seo !== 'undefined' && seo && seo.canonicalUrl) ? seo.canonicalUrl : '' %>">
  <meta name="twitter:title" content="<%= (typeof seo !== 'undefined' && seo && seo.title) ? seo.title : 'Portal Resmi DPM KBMFKG UMI' %>">
  <meta name="twitter:description" content="<%= (typeof seo !== 'undefined' && seo && seo.description) ? seo.description : 'Portal Resmi Parlemen Mahasiswa Fakultas Kedokteran Gigi Universitas Muslim Indonesia' %>">
  <meta name="twitter:image" content="<%= (typeof seo !== 'undefined' && seo && seo.ogImage) ? seo.ogImage : '/dpmfkgumi.webp' %>">

  <!-- Structured Data JSON-LD (Schema.org Graph: Organization, WebSite, WebPage, BreadcrumbList, SiteNavigationElement) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "EducationalOrganization",
        "@id": "<%= (typeof seo !== 'undefined' && seo && seo.baseUrl) ? seo.baseUrl : '' %>/#organization",
        "name": "<%= (typeof seo !== 'undefined' && seo && seo.namaLembaga) ? seo.namaLembaga : 'Dewan Perwakilan Mahasiswa KBMFKG UMI' %>",
        "alternateName": ["DPM FKG UMI", "DPM KBMFKG UMI", "Parlemen Kedokteran Gigi UMI"],
        "url": "<%= (typeof seo !== 'undefined' && seo && seo.canonicalUrl) ? seo.canonicalUrl : '' %>",
        "logo": {
          "@type": "ImageObject",
          "url": "<%= (typeof seo !== 'undefined' && seo && seo.ogImage) ? seo.ogImage : '/dpmfkgumi.webp' %>",
          "width": "512",
          "height": "512"
        },
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Sekretariat FKG UMI. Jl. Pajonga Dg. Ngalle No.27, Pa'batong, Kec. Mamajang",
          "addressLocality": "Makassar",
          "addressRegion": "Sulawesi Selatan",
          "postalCode": "90122",
          "addressCountry": "ID"
        },
        "department": {
          "@type": "CollegeOrUniversity",
          "name": "<%= (typeof seo !== 'undefined' && seo && seo.fakultas) ? seo.fakultas : 'Fakultas Kedokteran Gigi Universitas Muslim Indonesia' %>"
        }
      },
      {
        "@type": "WebSite",
        "@id": "<%= (typeof seo !== 'undefined' && seo && seo.baseUrl) ? seo.baseUrl : '' %>/#website",
        "url": "<%= (typeof seo !== 'undefined' && seo && seo.canonicalUrl) ? seo.canonicalUrl : '' %>",
        "name": "Portal Resmi DPM KBMFKG UMI",
        "publisher": {
          "@id": "<%= (typeof seo !== 'undefined' && seo && seo.baseUrl) ? seo.baseUrl : '' %>/#organization"
        },
        "potentialAction": {
          "@type": "SearchAction",
          "target": "<%= (typeof seo !== 'undefined' && seo && seo.baseUrl) ? seo.baseUrl : '' %>/#jdih?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      },
      {
        "@type": "WebPage",
        "@id": "<%= (typeof seo !== 'undefined' && seo && seo.baseUrl) ? seo.baseUrl : '' %>/#webpage",
        "url": "<%= (typeof seo !== 'undefined' && seo && seo.canonicalUrl) ? seo.canonicalUrl : '' %>",
        "name": "<%= (typeof seo !== 'undefined' && seo && seo.title) ? seo.title : 'Portal Resmi DPM KBMFKG UMI' %>",
        "description": "<%= (typeof seo !== 'undefined' && seo && seo.description) ? seo.description : '' %>",
        "inLanguage": "id-ID",
        "isPartOf": {
          "@id": "<%= (typeof seo !== 'undefined' && seo && seo.baseUrl) ? seo.baseUrl : '' %>/#website"
        },
        "breadcrumb": {
          "@id": "<%= (typeof seo !== 'undefined' && seo && seo.baseUrl) ? seo.baseUrl : '' %>/#breadcrumb"
        }
      },
      {
        "@type": "BreadcrumbList",
        "@id": "<%= (typeof seo !== 'undefined' && seo && seo.baseUrl) ? seo.baseUrl : '' %>/#breadcrumb",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Beranda",
            "item": "<%= (typeof seo !== 'undefined' && seo && seo.baseUrl) ? seo.baseUrl : '' %>/#home"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Profil Dewan",
            "item": "<%= (typeof seo !== 'undefined' && seo && seo.baseUrl) ? seo.baseUrl : '' %>/#profil"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Organisasi Kemahasiswaan Lingkup FKG UMI",
            "item": "<%= (typeof seo !== 'undefined' && seo && seo.baseUrl) ? seo.baseUrl : '' %>/#jdih"
          },
          {
            "@type": "ListItem",
            "position": 4,
            "name": "E-Aspirasi Advokasi",
            "item": "<%= (typeof seo !== 'undefined' && seo && seo.baseUrl) ? seo.baseUrl : '' %>/#aspirasi"
          },
          {
            "@type": "ListItem",
            "position": 5,
            "name": "Warta Sidang Parlemen",
            "item": "<%= (typeof seo !== 'undefined' && seo && seo.baseUrl) ? seo.baseUrl : '' %>/#berita"
          }
        ]
      },
      {
        "@type": "SiteNavigationElement",
        "name": [
          "Beranda",
          "Profil Dewan",
          "Organisasi Kemahasiswaan Lingkup FKG UMI",
          "E-Aspirasi Mahasiswa",
          "Warta Sidang",
          "Direktori Lembaga"
        ],
        "url": [
          "<%= (typeof seo !== 'undefined' && seo && seo.baseUrl) ? seo.baseUrl : '' %>/#home",
          "<%= (typeof seo !== 'undefined' && seo && seo.baseUrl) ? seo.baseUrl : '' %>/#profil",
          "<%= (typeof seo !== 'undefined' && seo && seo.baseUrl) ? seo.baseUrl : '' %>/#jdih",
          "<%= (typeof seo !== 'undefined' && seo && seo.baseUrl) ? seo.baseUrl : '' %>/#aspirasi",
          "<%= (typeof seo !== 'undefined' && seo && seo.baseUrl) ? seo.baseUrl : '' %>/#berita",
          "<%= (typeof seo !== 'undefined' && seo && seo.baseUrl) ? seo.baseUrl : '' %>/#ormawa"
        ]
      }
    ]
  }
  </script>

  <!-- Google Fonts & Core Styles -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

  <style>
    :root {
      /* Theme Light: Pure Soft Sky & Cyan */
      --primary-navy: #032B5F;
      --primary-emerald: #0284C7;
      --primary-emerald-dark: #0369A1;
      --primary-emerald-light: #38BDF8;
      --secondary-cyan: #06B6D4;
      --secondary-cyan-light: #67E8F9;
      --accent-cyan-soft: #E0F2FE;
      --accent-gold: #D97706;
      --accent-gold-light: #FBBF24;
      --bg-page: #F0F9FF;
      --bg-card: #FFFFFF;
      --bg-card-hover: #E0F2FE;
      --bg-surface-glass: rgba(255, 255, 255, 0.94);
      --text-primary: #0F172A;
      --text-secondary: #334155;
      --text-muted: #64748B;
      --border-subtle: #E0F2FE;
      --border-medium: #BAE6FD;
      --border-focus: #0EA5E9;
      --font-main: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --radius-full: 9999px;
      --shadow-sm: 0 1px 3px rgba(2, 132, 199, 0.08);
      --shadow-md: 0 4px 12px -2px rgba(2, 132, 199, 0.12), 0 2px 4px -1px rgba(2, 132, 199, 0.06);
      --shadow-lg: 0 16px 32px -4px rgba(2, 132, 199, 0.15), 0 4px 12px -2px rgba(2, 132, 199, 0.08);
    }

    [data-theme="dark"] {
      /* Theme Kedua: Biru Terang Soft Murni (Bebas Rona Ungu & Bebas Rona Hijau) */
      --primary-navy: #041728;
      --primary-emerald: #38BDF8;
      --primary-emerald-dark: #0284C7;
      --primary-emerald-light: #7DD3FC;
      --secondary-cyan: #00F0FF;
      --secondary-cyan-light: #67E8F9;
      --accent-cyan-soft: #082845;
      --accent-gold: #FBBF24;
      --bg-page: #041728; /* Deep oceanic cyan blue */
      --bg-card: #082845; /* Crisp ocean blue card */
      --bg-card-hover: #0C365D;
      --bg-surface-glass: rgba(8, 40, 69, 0.94);
      --text-primary: #F0F9FF; /* Ice white blue */
      --text-secondary: #BAE6FD; /* Soft bright sky blue */
      --text-muted: #7DD3FC;
      --border-subtle: #0C4A6E; /* Pure sky-900 blue */
      --border-medium: #0284C7;
      --border-focus: #38BDF8;
      --shadow-sm: 0 1px 3px rgba(0,0,0,0.5);
      --shadow-md: 0 4px 12px rgba(2, 132, 199, 0.3);
      --shadow-lg: 0 16px 36px rgba(2, 132, 199, 0.4);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: var(--font-main); }
    body { background: var(--bg-page); color: var(--text-primary); min-height: 100vh; overflow-x: hidden; }

    /* Public Navbar */
    .public-navbar {
      background: var(--bg-surface-glass);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border-subtle);
      position: sticky;
      top: 0;
      z-index: 1030;
      padding: 0.85rem 0;
      transition: all 0.3s ease;
    }
    .brand-logo-img {
      width: 42px; height: 42px;
      object-fit: contain;
      border-radius: 10px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.08);
    }
    .brand-title-wrap { display: flex; flex-direction: column; line-height: 1.15; }
    .brand-main-title { font-size: 1.15rem; font-weight: 800; color: var(--primary-emerald); letter-spacing: -0.01em; }
    [data-theme="dark"] .brand-main-title { color: #38BDF8; }
    .brand-sub-title { font-size: 0.72rem; color: var(--text-secondary); font-weight: 500; }

    .nav-link-custom {
      color: var(--text-secondary);
      font-weight: 600;
      font-size: 0.88rem;
      padding: 0.5rem 0.85rem;
      border-radius: var(--radius-sm);
      text-decoration: none;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .nav-link-custom:hover { color: var(--primary-emerald); background: rgba(2, 132, 199, 0.08); }
    [data-theme="dark"] .nav-link-custom:hover { color: #38BDF8; background: rgba(56, 189, 248, 0.12); }
    .nav-link-custom.active { color: #0284C7; background: rgba(2, 132, 199, 0.12); font-weight: 700; }
    [data-theme="dark"] .nav-link-custom.active { color: #38BDF8; background: rgba(56, 189, 248, 0.2); }

    /* WITA Clock Badge */
    .wita-badge {
      display: inline-flex; align-items: center; gap: 0.45rem;
      background: rgba(2, 132, 199, 0.08); color: var(--primary-emerald);
      padding: 0.35rem 0.75rem; border-radius: var(--radius-full);
      font-size: 0.8rem; font-weight: 600; font-family: var(--font-mono);
      border: 1px solid rgba(2, 132, 199, 0.18);
    }
    [data-theme="dark"] .wita-badge {
      background: rgba(56, 189, 248, 0.12); color: #38BDF8;
      border-color: rgba(56, 189, 248, 0.3);
    }
    .pulse-dot {
      width: 7px; height: 7px; background: #10b981; border-radius: 50%;
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); animation: pulse 2s infinite;
    }
    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
      70% { box-shadow: 0 0 0 7px rgba(16, 185, 129, 0); }
      100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }

    /* Buttons */
    .btn-emerald {
      background: linear-gradient(135deg, var(--primary-emerald) 0%, var(--primary-emerald-light) 100%);
      color: #FFFFFF; font-weight: 700; border: none;
      border-radius: var(--radius-md); padding: 0.65rem 1.25rem;
      box-shadow: 0 6px 16px -2px rgba(6, 78, 59, 0.3);
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .btn-emerald:hover { transform: translateY(-2px); box-shadow: 0 10px 22px -3px rgba(6, 78, 59, 0.4); color: #FFFFFF; }
    .btn-gold {
      background: linear-gradient(135deg, var(--accent-gold) 0%, var(--accent-gold-light) 100%);
      color: #FFFFFF; font-weight: 700; border: none;
      border-radius: var(--radius-md); padding: 0.65rem 1.25rem;
      box-shadow: 0 6px 16px -2px rgba(217, 119, 6, 0.3);
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .btn-gold:hover { transform: translateY(-2px); box-shadow: 0 10px 22px -3px rgba(217, 119, 6, 0.4); color: #FFFFFF; }
    .btn-outline-custom {
      border: 1.5px solid var(--border-medium); color: var(--text-primary);
      background: transparent; border-radius: var(--radius-md);
      padding: 0.5rem 0.95rem; font-weight: 600; font-size: 0.88rem;
      transition: all 0.2s ease;
    }
    .btn-outline-custom:hover { background: var(--bg-card-hover); border-color: var(--primary-emerald); color: var(--primary-emerald); }
    [data-theme="dark"] .btn-outline-custom:hover { border-color: #34d399; color: #34d399; }

    /* Hero Section */
    .hero-wrapper {
      padding: 5.5rem 0 4.5rem 0;
      position: relative;
      background-size: cover;
      background-position: center center;
      background-repeat: no-repeat;
      overflow: hidden;
    }
    .hero-overlay {
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      background: linear-gradient(135deg, rgba(240, 249, 255, 0.90) 0%, rgba(224, 242, 254, 0.82) 55%, rgba(186, 230, 253, 0.65) 100%);
      backdrop-filter: blur(1.5px);
      -webkit-backdrop-filter: blur(1.5px);
      z-index: 1;
    }
    [data-theme="dark"] .hero-overlay {
      background: linear-gradient(135deg, rgba(4, 23, 40, 0.92) 0%, rgba(8, 40, 69, 0.85) 55%, rgba(2, 132, 199, 0.50) 100%);
      backdrop-filter: blur(2px);
      -webkit-backdrop-filter: blur(2px);
    }
    .hero-content-relative {
      position: relative;
      z-index: 2;
    }
    .hero-badge-tag {
      display: inline-flex; align-items: center; gap: 0.5rem;
      padding: 0.45rem 1.1rem; border-radius: var(--radius-full);
      background: rgba(255, 255, 255, 0.85); color: var(--primary-emerald);
      font-size: 0.85rem; font-weight: 700; margin-bottom: 1.25rem;
      border: 1px solid rgba(2, 132, 199, 0.25);
      box-shadow: var(--shadow-sm);
      backdrop-filter: blur(8px);
    }
    [data-theme="dark"] .hero-badge-tag {
      background: rgba(8, 40, 69, 0.8); color: #38BDF8;
      border-color: rgba(56, 189, 248, 0.4);
    }
    .hero-title {
      font-size: 3rem; font-weight: 800; line-height: 1.18;
      letter-spacing: -0.025em; margin-bottom: 1.25rem;
    }
    @media (max-width: 768px) { .hero-title { font-size: 2.15rem; } }
    .hero-highlight {
      background: linear-gradient(135deg, var(--primary-emerald) 0%, var(--secondary-cyan) 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    [data-theme="dark"] .hero-highlight {
      background: linear-gradient(135deg, #38BDF8 0%, #00F0FF 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .hero-desc { font-size: 1.08rem; color: var(--text-secondary); line-height: 1.65; margin-bottom: 2rem; max-width: 620px; font-weight: 500; }

    /* Bento Stat Card */
    .bento-stat-card {
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1.5px solid rgba(2, 132, 199, 0.2);
      border-radius: var(--radius-lg);
      padding: 1.75rem;
      box-shadow: 0 10px 25px -5px rgba(2, 132, 199, 0.12), 0 8px 10px -6px rgba(2, 132, 199, 0.08);
    }
    [data-theme="dark"] .bento-stat-card {
      background: rgba(8, 40, 69, 0.85);
      border-color: rgba(56, 189, 248, 0.25);
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
    }
    .stat-row { display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 0; border-bottom: 1px dashed var(--border-subtle); }
    .stat-row:last-child { border-bottom: none; }

    /* Section Styling */
    .section-public { padding: 4.5rem 0; position: relative; }
    .section-header { text-align: center; margin-bottom: 3rem; }
    .section-tag {
      display: inline-block; font-size: 0.8rem; font-weight: 800;
      text-transform: uppercase; letter-spacing: 0.08em;
      color: var(--primary-emerald); margin-bottom: 0.5rem;
    }
    [data-theme="dark"] .section-tag { color: #38BDF8; }
    .section-title { font-size: 2.2rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 0.5rem; }
    .section-subtitle { font-size: 0.95rem; color: var(--text-secondary); max-width: 650px; margin: 0 auto; }

    .app-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 1.75rem;
      box-shadow: var(--shadow-sm);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .app-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }

    .badge-status {
      display: inline-flex; align-items: center; gap: 0.35rem;
      padding: 0.3rem 0.65rem; border-radius: var(--radius-full);
      font-size: 0.75rem; font-weight: 700;
    }
    .badge-status.success { background: rgba(16, 185, 129, 0.12); color: #10b981; }
    .badge-status.warning { background: rgba(245, 158, 11, 0.12); color: #f59e0b; }
    .badge-status.process { background: rgba(2, 132, 199, 0.12); color: #0284c7; }

    /* Search Bar */
    .search-input-box {
      background: var(--bg-card);
      border: 1.5px solid var(--border-medium);
      border-radius: var(--radius-md);
      padding: 0.75rem 1rem 0.75rem 2.85rem;
      width: 100%;
      outline: none;
      font-size: 0.95rem;
      color: var(--text-primary);
    }
    .search-input-box:focus { border-color: var(--border-focus); box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15); }

    /* Footer */
    .public-footer {
      background: #0B132B;
      color: #E2E8F0;
      padding: 4.5rem 0 2rem 0;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }
    .footer-brand-title { color: #FFFFFF; font-weight: 800; font-size: 1.25rem; }
    .footer-sub { color: #94A3B8; font-size: 0.88rem; line-height: 1.6; }
    .footer-heading { color: #FBBF24; font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 1.2rem; }
    .footer-link { color: #CBD5E1; text-decoration: none; font-size: 0.9rem; display: block; margin-bottom: 0.6rem; transition: color 0.2s; }
    .footer-link:hover { color: #34d399; }

    /* Modal Styling */
    .modal-content-custom {
      background: var(--bg-card);
      border: 1px solid var(--border-medium);
