          <div class="position-relative">
            <i class="bi bi-search position-absolute top-50 translate-middle-y text-muted" style="left: 1rem;"></i>
            <input type="text" class="search-input-box" id="jdihSearchInput" placeholder="Cari regulasi: ketetapan, anggaran, ormawa..." oninput="filterJdih()">
          </div>
        </div>
        <div class="col-md-3">
          <select class="form-select-custom h-100" id="jdihCategorySelect" onchange="filterJdih()">
            <option value="ALL">Semua Jenis Peraturan</option>
            <option value="TAP_DPM">Ketetapan Sidang (TAP DPM)</option>
            <option value="Undang_Undang">Undang-Undang Ormawa</option>
            <option value="Konstitusi_KBM">Konstitusi Dasar KBM</option>
            <option value="SOP">Standar Operasional (SOP)</option>
          </select>
        </div>
      </div>

      <!-- Cards Container -->
      <div class="row g-4" id="publicJdihContainer">
        <!-- Rendered dynamically -->
        <% if (typeof jdih !== 'undefined' && jdih && jdih.length > 0) { %>
          <% jdih.forEach(j => { %>
            <div class="col-md-6 col-lg-4 jdih-card-item" data-title="<%= j.judul_regulasi.toLowerCase() %>" data-type="<%= j.jenis_peraturan %>">
              <div class="app-card h-100 d-flex flex-column justify-content-between">
                <div>
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge-status process"><%= j.jenis_peraturan %></span>
                    <span class="font-mono small text-muted"><%= j.tahun_penetapan %></span>
                  </div>
                  <h5 class="fw-bold mb-2"><%= j.nomor_peraturan %></h5>
                  <p class="text-secondary small mb-3"><%= j.judul_regulasi %></p>
                </div>
                <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                  <span class="badge-status success"><%= j.status_hukum %></span>
                  <button class="btn btn-sm btn-outline-custom" onclick="openPdfPreview('<%= j.file_drive_url %>', '<%= j.judul_regulasi %>')">
                    <i class="bi bi-eye"></i> Baca Naskah
                  </button>
                </div>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>
  </section>

