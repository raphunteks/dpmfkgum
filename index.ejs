                <div class="form-check">
                  <input class="form-check-input" type="checkbox" id="chkAnonim" onchange="toggleAnonimMode()">
                  <label class="form-check-label small fw-semibold" for="chkAnonim">
                    Gunakan Mode Anonim (Nama & NIM disamarkan dari rekaman publik)
                  </label>
                </div>
              </div>
              <div class="col-md-6">
                <label class="form-label-custom">Jenjang Studi</label>
                <select class="form-select-custom" name="program_studi" required>
                  <option value="Sarjana_Kedokteran_Gigi">S1 Pendidikan Dokter Gigi (Pre-Klinik)</option>
                  <option value="Profesi_Dokter_Gigi_Koas">Profesi Dokter Gigi (Koas RSGM)</option>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label-custom">Kategori Isu</label>
                <select class="form-select-custom" name="kategori_isu" required>
                  <option value="Fasilitas_RSGM">Fasilitas & Dental Chair RSGM</option>
                  <option value="Akademik_Kurikulum">Akademik & Ujian Blok</option>
                  <option value="Kebijakan_Birokrasi">Kebijakan Dekanat / Pembayaran</option>
                  <option value="Kemahasiswaan">Kegiatan Ormawa & Fasilitas Kampus</option>
                </select>
              </div>
              <div class="col-12">
                <label class="form-label-custom">Pokok Aspirasi / Judul Pengaduan</label>
                <input type="text" class="form-control-custom" name="judul_aspirasi" placeholder="Ringkasan pokok keluhan atau usulan..." required>
              </div>
              <div class="col-12">
                <label class="form-label-custom">Detail Kronologi & Fakta Lapangan</label>
                <textarea class="form-control-custom" rows="4" name="isi_detail" placeholder="Jelaskan secara runtut fakta, kendala, atau solusi yang diusulkan..." required></textarea>
              </div>
              <div class="col-12 text-end mt-4">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                <button type="submit" class="btn btn-emerald"><i class="bi bi-send-fill"></i> Kirimkan Aspirasi</button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Tracking Tiket -->
  <div class="modal fade" id="modalTrackingTiket" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content modal-content-custom">
        <div class="modal-header p-4 border-bottom">
          <h5 class="modal-title fw-bold"><i class="bi bi-search me-2"></i>Lacak Status Aspirasi Anda</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-4">
          <div class="mb-3">
            <label class="form-label-custom">Masukkan Kode Tiket Aspirasi</label>
            <div class="input-group">
              <input type="text" class="form-control-custom font-mono" id="trackingKodeInput" placeholder="Contoh: ASP-89X2" style="text-transform: uppercase;">
              <button class="btn btn-emerald" onclick="trackTicketStatus()">Cek</button>
            </div>
          </div>
          <div id="trackingResultArea" class="mt-3" style="display: none;"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Preview PDF JDIH -->
  <div class="modal fade" id="modalPreviewDoc" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-xl">
      <div class="modal-content modal-content-custom">
        <div class="modal-header p-4 border-bottom">
          <h5 class="modal-title fw-bold" id="previewDocTitle">Pratinjau Dokumen Produk Hukum</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-0" style="height: 75vh;">
          <iframe id="previewDocFrame" src="" style="width: 100%; height: 100%; border: none;"></iframe>
        </div>
        <div class="modal-footer p-3 border-top d-flex justify-content-between">
          <small class="text-muted"><i class="bi bi-shield-check"></i> Dokumen resmi terverifikasi DPM KBMFKG UMI.</small>
          <a id="previewDocDownloadLink" href="#" target="_blank" class="btn btn-emerald btn-sm">
            <i class="bi bi-download"></i> Buka Tautan Asli
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast Notification -->
  <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 9999;">
    <div id="liveToast" class="toast align-items-center text-white bg-success border-0 shadow-lg" role="alert">
      <div class="d-flex">
        <div class="toast-body d-flex align-items-center gap-2" id="liveToastMessage">
          <i class="bi bi-check-circle-fill fs-5"></i> <span>Operasi berhasil!</span>
        </div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    // Theme Management
    function applyTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      localStorage.setItem('dpm_theme', theme);
      const icon = document.getElementById('themeIconNav');
      if (icon) icon.className = theme === 'dark' ? 'bi bi-sun-fill text-warning' : 'bi bi-moon-stars';
    }
    const savedTheme = localStorage.getItem('dpm_theme') || 'light';
    applyTheme(savedTheme);

    function toggleTheme() {
      const current = document.documentElement.getAttribute('data-theme') || 'light';
      applyTheme(current === 'dark' ? 'light' : 'dark');
    }

    // Live WITA Clock
    function updateClock() {
      const el = document.getElementById('liveWitaClock');
      if (!el) return;
      const d = new Date();
      el.textContent = d.toLocaleTimeString('id-ID', { hour12: false }) + ' WITA';
    }
    setInterval(updateClock, 1000);
    updateClock();

    // Toast
    function showToast(message, isSuccess = true) {
      const toastEl = document.getElementById('liveToast');
      const msg = document.getElementById('liveToastMessage');
      if (!toastEl) return;
      toastEl.className = `toast align-items-center text-white ${isSuccess ? 'bg-success' : 'bg-danger'} border-0 shadow-lg`;
      msg.innerHTML = `<i class="bi bi-${isSuccess ? 'check-circle-fill' : 'exclamation-triangle-fill'} fs-5"></i> <span>${message}</span>`;
      const t = new bootstrap.Toast(toastEl, { delay: 3500 });
      t.show();
    }

    // Navigation Scrolling & History URL PushState
    function showPublicSection(secId) {
      const target = document.getElementById('public-' + secId);
      if (target) {
        target.scrollIntoView({ behavior: 'smooth' });
      }
    }

    function navigatePublicSection(event, secId, targetUrl) {
      if (window.location.pathname === '/' || window.location.pathname === targetUrl || targetUrl.startsWith('/')) {
        if (event) event.preventDefault();
        showPublicSection(secId);
        window.history.pushState({ section: secId }, '', targetUrl);
        document.querySelectorAll('.nav-link-custom').forEach(el => el.classList.remove('active'));
        if (event && event.currentTarget) event.currentTarget.classList.add('active');
      }
    }

    // Auto-scroll on initial load based on activePage
    window.addEventListener('DOMContentLoaded', () => {
      const p = "<%= (typeof activePage !== 'undefined') ? activePage : 'home' %>";
      if (p === 'profil') setTimeout(() => showPublicSection('profil'), 180);
      else if (p === 'regulasi') setTimeout(() => showPublicSection('jdih'), 180);
      else if (p === 'aspirasi') setTimeout(() => showPublicSection('aspirasi'), 180);
      else if (p === 'berita') setTimeout(() => showPublicSection('berita'), 180);
      else if (p === 'lembaga') setTimeout(() => showPublicSection('ormawa'), 180);
    });

    window.addEventListener('popstate', () => {
      const path = window.location.pathname.replace('/', '') || 'home';
      if (path === 'profil') showPublicSection('profil');
      else if (path === 'regulasi') showPublicSection('jdih');
      else if (path === 'aspirasi') showPublicSection('aspirasi');
      else if (path === 'berita') showPublicSection('berita');
      else if (path === 'lembaga') showPublicSection('ormawa');
      else showPublicSection('home');
    });

    // Filter JDIH Regulations
    function filterJdih() {
      const q = (document.getElementById('jdihSearchInput')?.value || '').toLowerCase().trim();
      const type = document.getElementById('jdihCategorySelect')?.value || 'ALL';
      const items = document.querySelectorAll('.jdih-card-item');

      items.forEach(el => {
        const title = el.getAttribute('data-title') || '';
        const itemType = el.getAttribute('data-type') || '';
        const matchQ = !q || title.includes(q);
        const matchType = type === 'ALL' || itemType === type;
        el.style.display = (matchQ && matchType) ? 'block' : 'none';
      });
    }

    // Modal Helpers
    function openAspirasiModal() {
      new bootstrap.Modal(document.getElementById('modalAspirasiPublik')).show();
    }
    function openTrackingModal() {
      new bootstrap.Modal(document.getElementById('modalTrackingTiket')).show();
    }

    function toggleAnonimMode() {
      const isAnonim = document.getElementById('chkAnonim').checked;
      const nama = document.getElementById('aspNama');
      const nim = document.getElementById('aspNim');
      if (isAnonim) {
        nama.value = 'Mahasiswa Anonim';
        nim.value = '-';
        nama.readOnly = true;
        nim.readOnly = true;
      } else {
        nama.value = '';
        nim.value = '';
        nama.readOnly = false;
        nim.readOnly = false;
      }
    }

    // Submit Aspirasi
    async function handlePublicAspirasiSubmit(event) {
      event.preventDefault();
      const f = document.getElementById('formPublicAspirasi');
      const payload = {
        nama_mahasiswa: f.nama_mahasiswa.value,
        nim_stambuk: f.nim_stambuk.value,
        program_studi: f.program_studi.value,
        kategori_isu: f.kategori_isu.value,
        judul_aspirasi: f.judul_aspirasi.value,
        isi_detail: f.isi_detail.value
      };

      try {
        const res = await fetch('/api/public/aspirasi', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data && data.success) {
          bootstrap.Modal.getInstance(document.getElementById('modalAspirasiPublik')).hide();
          f.reset();
          showToast(`Aspirasi berhasil dikirim! Kode Tiket: ${data.data.kodeTiket}`);
          setTimeout(() => {
            document.getElementById('trackingKodeInput').value = data.data.kodeTiket;
            openTrackingModal();
            trackTicketStatus();
          }, 1000);
        } else {
          showToast(data?.message || 'Gagal mengirim aspirasi.', false);
        }
      } catch (e) {
        showToast('Terjadi kesalahan jaringan.', false);
      }
    }

    // Track Ticket Status
    async function trackTicketStatus() {
      const code = document.getElementById('trackingKodeInput').value.trim().toUpperCase();
      const area = document.getElementById('trackingResultArea');
      if (!code) {
        showToast('Masukkan kode tiket Anda.', false);
        return;
      }

      area.style.display = 'block';
      area.innerHTML = '<div class="text-center p-3"><div class="spinner-border spinner-border-sm text-success"></div> Mencari tiket...</div>';

      try {
        const res = await fetch('/api/public/aspirasi/' + code);
        const d = await res.json();
        if (d && d.success && d.data) {
          const item = d.data;
          area.innerHTML = `
            <div class="p-3 rounded border bg-light">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="font-mono fw-bold text-success">${item.kode_tiket}</span>
                <span class="badge-status ${item.status === 'Selesai' ? 'success' : 'warning'}">${item.status}</span>
              </div>
              <h6 class="fw-bold mb-1">${item.judul_aspirasi}</h6>
              <p class="text-muted small mb-2">${item.isi_detail}</p>
              <div class="small p-2 rounded bg-white border">
                <b>Tanggapan Dewan:</b><br>
                <span>${item.tanggapan_dewan || 'Sedang dalam telaah Komisi III DPM.'}</span>
              </div>
            </div>
          `;
        } else {
          area.innerHTML = '<div class="alert alert-warning small mb-0">Tiket tidak ditemukan. Periksa kembali kode tiket Anda.</div>';
        }
      } catch (e) {
        area.innerHTML = '<div class="alert alert-danger small mb-0">Gagal mengambil status tiket.</div>';
      }
    }

    // PDF Preview Modal
    function openPdfPreview(url, title) {
      document.getElementById('previewDocTitle').textContent = title || 'Pratinjau Dokumen';
      const frame = document.getElementById('previewDocFrame');
      const dlLink = document.getElementById('previewDocDownloadLink');
      let cleanUrl = url;
      if (cleanUrl.includes('drive.google.com') && cleanUrl.includes('/view')) {
        cleanUrl = cleanUrl.replace('/view', '/preview');
      }
      frame.src = cleanUrl;
      dlLink.href = url;
      new bootstrap.Modal(document.getElementById('modalPreviewDoc')).show();
    }
  </script>
</body>
</html>
